---
interface Props {
	baslik: string;
	ust?: string;
	aciklama?: string;
}
const { baslik, ust, aciklama } = Astro.props;
---

<div class="sayfa-basligi">
	{ust && <span class="ust">{ust}</span>}
	<div class="satir">
		<h1>{baslik}</h1>
		<slot />
	</div>
	{aciklama && <p>{aciklama}</p>}
</div>

<style>
	.sayfa-basligi {
		display: flex;
		flex-direction: column;
		gap: 8px;
	}
	.ust {
		font-size: 11px;
		font-weight: 600;
		letter-spacing: 1.4px;
		color: var(--etiket-metin);
	}
	.satir {
		display: flex;
		align-items: center;
		flex-wrap: wrap;
		gap: 12px;
	}
	h1 {
		font-size: 36px;
		line-height: 1.15;
		letter-spacing: -0.5px;
	}
	p {
		margin: 0;
		font-size: 15px;
		line-height: 1.6;
		color: var(--metin-ikincil);
		max-width: 680px;
	}
	@media (max-width: 899px) {
		.sayfa-basligi {
			padding-top: 8px;
		}
		h1 {
			font-size: 28px;
		}
	}
</style>
