---
interface Props {
	tur?: 'notr' | 'marka' | 'pro' | 'yukselis' | 'dusus' | 'ornek';
}
const { tur = 'notr' } = Astro.props;
---

<span class:list={['rozet', tur]}><slot /></span>

<style>
	.rozet {
		display: inline-flex;
		align-items: center;
		gap: 4px;
		font-size: 12px;
		font-weight: 600;
		padding: 3px 8px;
		border-radius: 2px;
		white-space: nowrap;
		line-height: 1.4;
	}
	.notr {
		background: #17140f;
		color: var(--metin-ikincil);
	}
	.ornek {
		background: #17140f;
		color: var(--metin-ikincil);
		font-size: 11px;
	}
	.marka {
		background: #1f1805;
		color: #ffcb4d;
	}
	.pro {
		background: var(--kehribar);
		color: var(--koyu);
		font-size: 10px;
		letter-spacing: 0.6px;
		padding: 2px 6px;
		border-radius: 2px;
	}
	.yukselis {
		background: #10231a;
		color: var(--yukselis);
	}
	.dusus {
		background: #2a1311;
		color: var(--dusus);
	}
</style>
