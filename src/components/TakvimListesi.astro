---
import { TUR_ETIKETLERI, type TakvimEtkinligi } from '../lib/takvim';

interface Props {
	etkinlikler: TakvimEtkinligi[];
	bosMesaj?: string;
}
const { etkinlikler, bosMesaj = 'Henüz etkinlik girilmedi.' } = Astro.props;

const aylar = ['OCA', 'ŞUB', 'MAR', 'NİS', 'MAY', 'HAZ', 'TEM', 'AĞU', 'EYL', 'EKİ', 'KAS', 'ARA'];
function parcala(tarih: string) {
	const [, ay, gun] = tarih.split('-').map(Number);
	return { gun: String(gun).padStart(2, '0'), ay: aylar[ay - 1] ?? '' };
}
---

{
	etkinlikler.length === 0 ? (
		<p class="bos">{bosMesaj}</p>
	) : (
		<div class="takvim-listesi">
			{etkinlikler.map((e) => {
				const { gun, ay } = parcala(e.tarih);
				return (
					<div class="takvim-satir">
						<span class="takvim-tarih">
							<span class="gun">{gun}</span>
							<span class="ay">{ay}</span>
						</span>
						<span class="takvim-icerik">
							<span class:list={['takvim-tur', e.tur]}>{TUR_ETIKETLERI[e.tur]}</span>
							<span class="takvim-baslik">
								{e.hisse && (
									<a href={`/hisse/${e.hisse}`} class="takvim-hisse">
										{e.hisse}
									</a>
								)}{' '}
								{e.baslik}
							</span>
							{e.aciklama && <span class="takvim-aciklama">{e.aciklama}</span>}
						</span>
					</div>
				);
			})}
		</div>
	)
}

<style>
	.bos {
		margin: 0;
		font-size: 14px;
		color: var(--metin-ikincil);
		padding: 24px;
		text-align: center;
		background: #faf9f5;
		border-radius: 10px;
	}
	.takvim-listesi {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.takvim-satir {
		display: flex;
		gap: 16px;
		align-items: flex-start;
		padding: 10px 0;
		border-bottom: 1px solid var(--cizgi);
	}
	.takvim-satir:last-child {
		border-bottom: 0;
	}
	.takvim-tarih {
		width: 52px;
		flex-shrink: 0;
		text-align: center;
		border: 1px solid var(--kenarlik);
		border-radius: 8px;
		padding: 6px 0;
		display: flex;
		flex-direction: column;
	}
	.gun {
		font-family: var(--font-baslik);
		font-size: 18px;
		font-weight: 600;
		line-height: 1.1;
	}
	.ay {
		font-size: 10px;
		font-weight: 600;
		letter-spacing: 0.8px;
		color: var(--metin-ikincil);
	}
	.takvim-icerik {
		display: flex;
		flex-direction: column;
		gap: 3px;
		min-width: 0;
	}
	.takvim-tur {
		font-size: 11px;
		font-weight: 700;
		letter-spacing: 0.5px;
		text-transform: uppercase;
		width: fit-content;
	}
	.takvim-tur.temettu {
		color: var(--yukselis);
	}
	.takvim-tur.bedelsiz,
	.takvim-tur.halka_arz {
		color: var(--marka);
	}
	.takvim-tur.genel_kurul,
	.takvim-tur.spk_bulten,
	.takvim-tur.diger {
		color: var(--metin-ikincil);
	}
	.takvim-baslik {
		font-size: 14px;
	}
	.takvim-hisse {
		font-family: var(--font-mono);
		font-weight: 600;
		color: var(--metin);
	}
	.takvim-aciklama {
		font-size: 12px;
		color: var(--metin-ikincil);
	}
</style>
