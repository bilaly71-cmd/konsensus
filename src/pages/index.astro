---
import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Kart from '../components/Kart.astro';
import Rozet from '../components/Rozet.astro';
import Buton from '../components/Buton.astro';
import Tablo from '../components/Tablo.astro';

const kpiler = [
	{ ad: 'Bugünkü öneri', alt: 'kurumlardan derlenir' },
	{ ad: 'Konsensüs hissesi', alt: 'en az 3 kurumun önerdiği' },
	{ ad: 'Hedefi yükselen', alt: 'son 24 saatte' },
	{ ad: 'Hedefi düşen', alt: 'son 24 saatte' },
];

const oneriKolonlari = [
	{ anahtar: 'kurum', baslik: 'Kurum' },
	{ anahtar: 'hisse', baslik: 'Hisse', tur: 'hisse' as const },
	{ anahtar: 'tur', baslik: 'Tür' },
	{ anahtar: 'giris', baslik: 'Giriş', hiza: 'sag' as const },
	{ anahtar: 'hedef', baslik: 'Hedef', hiza: 'sag' as const, tur: 'kalin' as const },
	{ anahtar: 'stop', baslik: 'Stop', hiza: 'sag' as const, tur: 'soluk' as const },
	{ anahtar: 'pot', baslik: 'Potansiyel', hiza: 'sag' as const, tur: 'yon' as const },
];
---

<AnaLayout baslik="Gösterge paneli">
	<SayfaBasligi
		baslik="Gösterge paneli"
		ust="PİYASA"
		aciklama="Günün önerileri, konsensüs hisseleri, hedef revizyonları ve öneri karnesi tek ekranda."
	>
		<Rozet>Yapım aşamasında</Rozet>
	</SayfaBasligi>

	<section class="kpi-izgara" aria-label="Özet">
		{
			kpiler.map((k) => (
				<div class="kpi">
					<span class="kpi-ad">{k.ad}</span>
					<span class="kpi-deger">—</span>
					<span class="kpi-alt">{k.alt}</span>
				</div>
			))
		}
	</section>

	<section class="izgara">
		<Kart baslik="Günün konsensüsü" altBaslik="En çok kurumun aynı anda önerdiği hisseler" class="genis">
			<p class="bos">Öneriler girilmeye başladığında burada görünecek.</p>
		</Kart>
		<Kart baslik="Öneri karnesi" etiket="YAKINDA" koyu class="dar">
			<p class="koyu-metin">
				Günlük önerilerin 5 işlem günü içinde hedefe ulaşma oranı. Yöntem sayfasında açıkça
				anlatılacak.
			</p>
		</Kart>
	</section>

	<Kart baslik="Bugünkü öneriler" altBaslik="Kaynak her satırda">
		<Fragment slot="sag"><a href="/oneriler">Tümü</a></Fragment>
		<Tablo kolonlar={oneriKolonlari} satirlar={[]} bosMesaj="Bugün için henüz öneri girilmedi." />
	</Kart>

	<section class="izgara">
		<Kart etiket="ARAÇLAR" baslik="Teminat simülatörü" class="genis">
			<p class="metin">
				Hisse fiyatı düşerse özkaynak oranın ne olur, çağrı gelir mi? Birkaç saniyede gör.
			</p>
			<div><Buton href="/teminat-simulatoru">Simülatöre git</Buton></div>
		</Kart>
		<Kart etiket="ARENA" baslik="Grafik oyunu" class="dar">
			<p class="metin">Grafik burada kesildi. Sence devamı?</p>
			<div><Buton href="/grafik-oyunu" tur="ikincil">Oyuna göz at</Buton></div>
		</Kart>
	</section>
</AnaLayout>

<style>
	.kpi-izgara {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}
	.kpi {
		background: var(--kart);
		border: 1px solid var(--kenarlik);
		border-radius: 14px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.kpi-ad {
		font-size: 13px;
		color: var(--metin-ikincil);
		font-weight: 500;
	}
	.kpi-deger {
		font-family: var(--font-baslik);
		font-size: 38px;
		font-weight: 600;
		line-height: 1;
	}
	.kpi-alt {
		font-size: 12px;
		color: var(--metin-ikincil);
	}
	.izgara {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 24px;
	}
	.izgara > :global(.genis) {
		grid-column: span 7;
	}
	.izgara > :global(.dar) {
		grid-column: span 5;
	}
	.bos {
		margin: 0;
		font-size: 14px;
		color: var(--metin-ikincil);
		padding: 24px;
		text-align: center;
		background: #faf9f5;
		border-radius: 10px;
	}
	.koyu-metin {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: #aeb3bf;
	}
	.metin {
		margin: 0;
		font-size: 14px;
		line-height: 1.55;
		color: #3f434c;
	}

	@media (max-width: 1100px) {
		.kpi-izgara {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 899px) {
		.kpi-izgara {
			gap: 10px;
		}
		.kpi {
			padding: 14px;
		}
		.kpi-deger {
			font-size: 30px;
		}
		.izgara {
			display: flex;
			flex-direction: column;
			gap: 16px;
		}
	}
</style>
