---
export const prerender = false;

import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Kart from '../components/Kart.astro';
import Rozet from '../components/Rozet.astro';
import Buton from '../components/Buton.astro';
import Tablo from '../components/Tablo.astro';
import { bugunIstanbul } from '../lib/tarih';
import { getDb } from '../lib/db';

const db = getDb();
const bugun = bugunIstanbul();
const { results: bugunkuOneriler } = await db
	.prepare('SELECT * FROM oneriler WHERE tarih = ?1 ORDER BY olusturulma DESC')
	.bind(bugun)
	.all<Record<string, string>>();

const oneriSatirlari = bugunkuOneriler.map((o) => ({
	kurum: o.kurum,
	hisse: o.hisse,
	tur: o.tur,
	giris: o.giris ?? '—',
	hedef: o.hedef,
	stop: o.stop ?? '—',
	pot: o.potansiyel ?? '—',
}));

const kurumlarHisseBazinda = new Map<string, Set<string>>();
for (const o of bugunkuOneriler) {
	if (!kurumlarHisseBazinda.has(o.hisse)) kurumlarHisseBazinda.set(o.hisse, new Set());
	kurumlarHisseBazinda.get(o.hisse)!.add(o.kurum);
}
const konsensusListesi = [...kurumlarHisseBazinda.entries()]
	.map(([hisse, kurumlar]) => ({ hisse, kurumlar: [...kurumlar], n: kurumlar.size }))
	.filter((k) => k.n >= 2)
	.sort((a, b) => b.n - a.n);
const enCokKurum = konsensusListesi[0]?.n || 1;

const kpiler = [
	{ ad: 'Bugünkü öneri', deger: String(bugunkuOneriler.length), alt: 'kurumlardan derlenir' },
	{ ad: 'Konsensüs hissesi', deger: String(konsensusListesi.length), alt: 'en az 2 kurumun önerdiği' },
	{ ad: 'Hedefi yükselen', deger: '—', alt: 'yakında: hedef geçmişi' },
	{ ad: 'Hedefi düşen', deger: '—', alt: 'yakında: hedef geçmişi' },
];

const sirketHaberleri = [
	'[Şirket] KAP bildirimi: [özet]',
	'[Şirket] yönetim kurulu kararı: [özet]',
	'[Şirket] finansal sonuç açıkladı: [özet]',
];

const piyasaHaberleri = [
	'[Başlık]: genel piyasa gündemi özeti',
	'[Başlık]: makro veri / merkez bankası özeti',
	'[Başlık]: küresel piyasalardan özet',
];

const oneriKolonlari = [
	{ anahtar: 'kurum', baslik: 'Kurum' },
	{ anahtar: 'hisse', baslik: 'Hisse', tur: 'hisse' as const },
	{ anahtar: 'tur', baslik: 'Tür' },
	{ anahtar: 'giris', baslik: 'Giriş', hiza: 'sag' as const },
	{ anahtar: 'hedef', baslik: 'Hedef', hiza: 'sag' as const, tur: 'kalin' as const },
	{ anahtar: 'stop', baslik: 'Stop', hiza: 'sag' as const, tur: 'soluk' as const },
	{ anahtar: 'pot', baslik: 'Potansiyel', hiza: 'sag' as const, tur: 'yon' as const },
];
---

<AnaLayout baslik="Gösterge paneli">
	<SayfaBasligi
		baslik="Gösterge paneli"
		ust="PİYASA"
		aciklama="Günün önerileri, konsensüs hisseleri, hedef revizyonları ve öneri karnesi tek ekranda."
	>
		<Rozet>Yapım aşamasında</Rozet>
	</SayfaBasligi>

	<section class="haber-izgara" aria-label="Haberler">
		<Kart baslik="Şirket haberleri" altBaslik="KAP özetleri · kaynak linkli" class="haber-kart">
			<Fragment slot="sag"><a href="/oneriler">Tümü</a></Fragment>
			<ul class="haber-listesi">
				{
					sirketHaberleri.map((h) => (
						<li>
							<span class="nokta" />
							<span class="metin">{h}</span>
						</li>
					))
				}
			</ul>
		</Kart>
		<Kart baslik="Piyasa haberleri" altBaslik="Genel gündem" class="haber-kart">
			<Fragment slot="sag"><a href="/takvim">Tümü</a></Fragment>
			<ul class="haber-listesi">
				{
					piyasaHaberleri.map((h) => (
						<li>
							<span class="nokta" />
							<span class="metin">{h}</span>
						</li>
					))
				}
			</ul>
		</Kart>
	</section>

	<section class="kpi-izgara" aria-label="Özet">
		{
			kpiler.map((k) => (
				<div class="kpi">
					<span class="kpi-ad">{k.ad}</span>
					<span class="kpi-deger">{k.deger}</span>
					<span class="kpi-alt">{k.alt}</span>
				</div>
			))
		}
	</section>

	<section class="izgara">
		<Kart baslik="Günün konsensüsü" altBaslik="En çok kurumun aynı anda önerdiği hisseler" class="genis">
			{
				konsensusListesi.length === 0 ? (
					<p class="bos">Bugün için henüz konsensüs hissesi yok (en az 2 kurumun aynı hisseyi önermesi gerekir).</p>
				) : (
					<div class="konsensus-listesi">
						{konsensusListesi.map((k) => (
							<a href="/hedef-fiyatlar" class="konsensus-satir">
								<span class="konsensus-hisse">{k.hisse}</span>
								<span class="konsensus-cubuk">
									<span class="konsensus-dolu" style={`width:${Math.round((k.n / enCokKurum) * 100)}%`} />
								</span>
								<span class="konsensus-kurumlar">{k.kurumlar.join(' · ')}</span>
								<span class="konsensus-n">{k.n} kurum</span>
							</a>
						))}
					</div>
				)
			}
		</Kart>
		<Kart baslik="Öneri karnesi" etiket="YAKINDA" koyu class="dar">
			<p class="koyu-metin">
				Günlük önerilerin 5 işlem günü içinde hedefe ulaşma oranı. Yöntem sayfasında açıkça
				anlatılacak.
			</p>
		</Kart>
	</section>

	<Kart baslik="Bugünkü öneriler" altBaslik="Kaynak her satırda">
		<Fragment slot="sag"><a href="/oneriler">Tümü</a></Fragment>
		<Tablo kolonlar={oneriKolonlari} satirlar={oneriSatirlari} bosMesaj="Bugün için henüz öneri girilmedi." />
	</Kart>

	<section class="izgara">
		<Kart etiket="ARAÇLAR" baslik="Teminat simülatörü" class="genis">
			<p class="metin">
				Hisse fiyatı düşerse özkaynak oranın ne olur, çağrı gelir mi? Birkaç saniyede gör.
			</p>
			<div><Buton href="/teminat-simulatoru">Simülatöre git</Buton></div>
		</Kart>
		<Kart etiket="ARENA" baslik="Grafik oyunu" class="dar">
			<p class="metin">Grafik burada kesildi. Sence devamı?</p>
			<div><Buton href="/grafik-oyunu" tur="ikincil">Oyuna göz at</Buton></div>
		</Kart>
	</section>
</AnaLayout>

<style>
	.konsensus-listesi {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.konsensus-satir {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr) 150px;
		align-items: center;
		gap: 16px;
		color: var(--metin);
		padding: 4px 0;
	}
	.konsensus-hisse {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 14px;
	}
	.konsensus-cubuk {
		height: 10px;
		background: #efece4;
		border-radius: 5px;
		overflow: hidden;
		display: block;
	}
	.konsensus-dolu {
		display: block;
		height: 10px;
		background: var(--marka);
		border-radius: 5px;
	}
	.konsensus-kurumlar {
		grid-column: 2;
		grid-row: 2;
		font-size: 12px;
		color: var(--metin-ikincil);
	}
	.konsensus-satir {
		grid-template-rows: auto auto;
	}
	.konsensus-n {
		grid-column: 3;
		grid-row: 1 / span 2;
		text-align: right;
		font-size: 16px;
		font-weight: 600;
		align-self: center;
	}
	.haber-izgara {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.haber-kart {
		padding: 18px 20px;
		gap: 10px;
	}
	.haber-listesi {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.haber-listesi li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 7px 0;
		border-bottom: 1px solid var(--cizgi);
		font-size: 13px;
	}
	.haber-listesi li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.haber-listesi .nokta {
		flex-shrink: 0;
		width: 5px;
		height: 5px;
		border-radius: 3px;
		background: var(--kehribar);
		margin-top: 7px;
	}
	.haber-listesi .metin {
		color: var(--metin);
		line-height: 1.4;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.kpi-izgara {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}
	.kpi {
		background: var(--kart);
		border: 1px solid var(--kenarlik);
		border-radius: 14px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.kpi-ad {
		font-size: 13px;
		color: var(--metin-ikincil);
		font-weight: 500;
	}
	.kpi-deger {
		font-family: var(--font-baslik);
		font-size: 38px;
		font-weight: 600;
		line-height: 1;
	}
	.kpi-alt {
		font-size: 12px;
		color: var(--metin-ikincil);
	}
	.izgara {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 24px;
	}
	.izgara > :global(.genis) {
		grid-column: span 7;
	}
	.izgara > :global(.dar) {
		grid-column: span 5;
	}
	.bos {
		margin: 0;
		font-size: 14px;
		color: var(--metin-ikincil);
		padding: 24px;
		text-align: center;
		background: #faf9f5;
		border-radius: 10px;
	}
	.koyu-metin {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: #aeb3bf;
	}
	.metin {
		margin: 0;
		font-size: 14px;
		line-height: 1.55;
		color: #3f434c;
	}

	@media (max-width: 1100px) {
		.kpi-izgara {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 899px) {
		.haber-izgara {
			grid-template-columns: 1fr;
			gap: 10px;
		}
		.haber-listesi .metin {
			white-space: normal;
		}
		.kpi-izgara {
			gap: 10px;
		}
		.kpi {
			padding: 14px;
		}
		.kpi-deger {
			font-size: 30px;
		}
		.izgara {
			display: flex;
			flex-direction: column;
			gap: 16px;
		}
	}
</style>
