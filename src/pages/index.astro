---
export const prerender = false;

import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Kart from '../components/Kart.astro';
import Rozet from '../components/Rozet.astro';
import Buton from '../components/Buton.astro';
import Tablo from '../components/Tablo.astro';
import { bugunIstanbul } from '../lib/tarih';
import { getDb } from '../lib/db';
import { tariheGoreOneriler, konsensusHesapla, tumOneriler, hedefRevizyonlariHesapla, kurumKarneleriHesapla } from '../lib/oneriler';
import { sonHaberler } from '../lib/haberler';

const db = getDb();
const bugun = bugunIstanbul();
const bugunkuOneriler = await tariheGoreOneriler(db, bugun);
const tumKayitlar = await tumOneriler(db);
const revizyonlar = hedefRevizyonlariHesapla(tumKayitlar, bugun);
const revizyonYukselen = revizyonlar.filter((r) => r.yon === 'yukselir').length;
const revizyonDusen = revizyonlar.filter((r) => r.yon === 'duser').length;

const oneriSatirlari = bugunkuOneriler.map((o) => ({
	kurum: o.kurum,
	hisse: o.hisse,
	tur: o.tur,
	giris: o.giris ?? '—',
	hedef: o.hedef,
	stop: o.stop ?? '—',
	pot: o.potansiyel ?? '—',
}));

const konsensusListesi = konsensusHesapla(bugunkuOneriler);
const enCokKurum = konsensusListesi[0]?.n || 1;

const karneler = kurumKarneleriHesapla(tumKayitlar).slice(0, 5);
const enYuksekIsabet = karneler[0]?.isabetOrani || 1;

const kpiler = [
	{ ad: 'Bugünkü öneri', deger: String(bugunkuOneriler.length), alt: 'kurumlardan derlenir' },
	{ ad: 'Konsensüs hissesi', deger: String(konsensusListesi.length), alt: 'en az 2 kurumun önerdiği' },
	{ ad: 'Hedefi yükselen', deger: String(revizyonYukselen), alt: 'bugün, önceki girişe göre' },
	{ ad: 'Hedefi düşen', deger: String(revizyonDusen), alt: 'bugün, önceki girişe göre' },
];

const sirketHaberleriKayitlari = await sonHaberler(db, 'sirket');
const piyasaHaberleriKayitlari = await sonHaberler(db, 'piyasa');

const oneriKolonlari = [
	{ anahtar: 'kurum', baslik: 'Kurum' },
	{ anahtar: 'hisse', baslik: 'Hisse', tur: 'hisse' as const },
	{ anahtar: 'tur', baslik: 'Tür' },
	{ anahtar: 'giris', baslik: 'Giriş', hiza: 'sag' as const },
	{ anahtar: 'hedef', baslik: 'Hedef', hiza: 'sag' as const, tur: 'kalin' as const },
	{ anahtar: 'stop', baslik: 'Stop', hiza: 'sag' as const, tur: 'soluk' as const },
	{ anahtar: 'pot', baslik: 'Potansiyel', hiza: 'sag' as const, tur: 'yon' as const },
];
---

<AnaLayout baslik="Gösterge paneli">
	<SayfaBasligi
		baslik="Gösterge paneli"
		ust="PİYASA"
		aciklama="Günün önerileri, konsensüs hisseleri, hedef revizyonları ve öneri karnesi tek ekranda."
	>
		<Rozet>Yapım aşamasında</Rozet>
	</SayfaBasligi>

	<section class="haber-izgara" aria-label="Haberler">
		<Kart baslik="Şirket haberleri" altBaslik="KAP özetleri · kaynak linkli" class="haber-kart">
			<Fragment slot="sag"><a href="/oneriler">Tümü</a></Fragment>
			{
				sirketHaberleriKayitlari.length === 0 ? (
					<p class="haber-bos">Henüz haber girilmedi.</p>
				) : (
					<ul class="haber-listesi">
						{sirketHaberleriKayitlari.map((h) => (
							<li>
								<span class="nokta" />
								{h.hisse && (
									<a href={`/hisse/${h.hisse}`} class="haber-hisse">
										{h.hisse}
									</a>
								)}
								{h.kaynak_url ? (
									<a href={h.kaynak_url} target="_blank" rel="noopener" class="metin">
										{h.baslik}
									</a>
								) : (
									<span class="metin">{h.baslik}</span>
								)}
							</li>
						))}
					</ul>
				)
			}
		</Kart>
		<Kart baslik="Piyasa haberleri" altBaslik="Genel gündem" class="haber-kart">
			<Fragment slot="sag"><a href="/takvim">Tümü</a></Fragment>
			{
				piyasaHaberleriKayitlari.length === 0 ? (
					<p class="haber-bos">Henüz haber girilmedi.</p>
				) : (
					<ul class="haber-listesi">
						{piyasaHaberleriKayitlari.map((h) => (
							<li>
								<span class="nokta" />
								{h.kaynak_url ? (
									<a href={h.kaynak_url} target="_blank" rel="noopener" class="metin">
										{h.baslik}
									</a>
								) : (
									<span class="metin">{h.baslik}</span>
								)}
							</li>
						))}
					</ul>
				)
			}
		</Kart>
	</section>

	<section class="kpi-izgara" aria-label="Özet">
		{
			kpiler.map((k) => (
				<div class="kpi">
					<span class="kpi-ad">{k.ad}</span>
					<span class="kpi-deger">{k.deger}</span>
					<span class="kpi-alt">{k.alt}</span>
				</div>
			))
		}
	</section>

	<section class="izgara">
		<Kart baslik="Günün konsensüsü" altBaslik="En çok kurumun aynı anda önerdiği hisseler" class="genis">
			{
				konsensusListesi.length === 0 ? (
					<p class="bos">Bugün için henüz konsensüs hissesi yok (en az 2 kurumun aynı hisseyi önermesi gerekir).</p>
				) : (
					<div class="konsensus-listesi">
						{konsensusListesi.map((k) => (
							<a href={`/hisse/${k.hisse}`} class="konsensus-satir">
								<span class="konsensus-hisse">{k.hisse}</span>
								<span class="konsensus-cubuk">
									<span class="konsensus-dolu" style={`width:${Math.round((k.n / enCokKurum) * 100)}%`} />
								</span>
								<span class="konsensus-kurumlar">{k.kurumlar.join(' · ')}</span>
								<span class="konsensus-n">{k.n} kurum</span>
							</a>
						))}
					</div>
				)
			}
		</Kart>
		<Kart baslik="Öneri karnesi" koyu class="dar">
			<Fragment slot="sag"><a href="/oneri-karnesi" class="karne-link">Yöntem</a></Fragment>
			{
				karneler.length === 0 ? (
					<p class="koyu-metin">
						Henüz sonuçlanmış öneri yok. Sonuçlar panelden işaretlendikçe kurum sıralaması burada
						görünecek.
					</p>
				) : (
					<div class="karne-listesi">
						{karneler.map((k, i) => (
							<div class="karne-satir">
								<span class="karne-sira">{i + 1}</span>
								<span class="karne-kurum">{k.kurum}</span>
								<span class="karne-cubuk">
									<span class="karne-dolu" style={`width:${Math.round((k.isabetOrani / enYuksekIsabet) * 100)}%`} />
								</span>
								<span class="karne-yuzde">%{k.isabetOrani.toFixed(0)}</span>
							</div>
						))}
					</div>
				)
			}
			<a href="/oneri-karnesi" class="karne-tum-link">Tüm kurumların karnesi</a>
		</Kart>
	</section>

	<Kart baslik="Bugünkü öneriler" altBaslik="Kaynak her satırda">
		<Fragment slot="sag"><a href="/oneriler">Tümü</a></Fragment>
		<Tablo kolonlar={oneriKolonlari} satirlar={oneriSatirlari} bosMesaj="Bugün için henüz öneri girilmedi." />
	</Kart>

	{
		revizyonlar.length > 0 && (
			<Kart baslik="Hedef revizyonları" altBaslik="Bugün, aynı kurumun önceki girişine göre">
				<div class="revizyon-listesi">
					{revizyonlar.map((r) => (
						<a href={`/hisse/${r.hisse}`} class="revizyon-satir">
							<span class:list={['revizyon-ok', r.yon]}>{r.yon === 'yukselir' ? '▲' : '▼'}</span>
							<span class="revizyon-orta">
								<span class="revizyon-hisse">{r.hisse}</span>
								<span class="revizyon-kurum">{r.kurum}</span>
							</span>
							<span class="revizyon-degerler">
								<span class="eski">{r.eskiHedef} →</span>
								<span class:list={['yeni', r.yon]}>{r.yeniHedef}</span>
							</span>
						</a>
					))}
				</div>
			</Kart>
		)
	}

	<section class="izgara">
		<Kart etiket="ARAÇLAR" baslik="Teminat simülatörü" class="genis">
			<p class="metin">
				Hisse fiyatı düşerse özkaynak oranın ne olur, çağrı gelir mi? Birkaç saniyede gör.
			</p>
			<div><Buton href="/teminat-simulatoru">Simülatöre git</Buton></div>
		</Kart>
		<Kart etiket="ARENA" baslik="Grafik oyunu" class="dar">
			<p class="metin">Grafik burada kesildi. Sence devamı?</p>
			<div><Buton href="/grafik-oyunu" tur="ikincil">Oyuna göz at</Buton></div>
		</Kart>
	</section>
</AnaLayout>

<style>
	.revizyon-listesi {
		display: flex;
		flex-direction: column;
		gap: 4px;
	}
	.revizyon-satir {
		display: grid;
		grid-template-columns: 32px minmax(0, 1fr) auto;
		align-items: center;
		gap: 14px;
		padding: 8px 0;
		border-bottom: 1px solid var(--cizgi);
		color: var(--metin);
	}
	.revizyon-satir:last-child {
		border-bottom: 0;
	}
	.revizyon-ok {
		width: 28px;
		height: 28px;
		border-radius: 8px;
		display: flex;
		align-items: center;
		justify-content: center;
		font-size: 13px;
		font-weight: 700;
	}
	.revizyon-ok.yukselir {
		background: #e3f2ea;
		color: var(--yukselis);
	}
	.revizyon-ok.duser {
		background: #f8e4e2;
		color: var(--dusus);
	}
	.revizyon-orta {
		display: flex;
		flex-direction: column;
		min-width: 0;
	}
	.revizyon-hisse {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 14px;
	}
	.revizyon-kurum {
		font-size: 12px;
		color: var(--metin-ikincil);
	}
	.revizyon-degerler {
		display: flex;
		align-items: baseline;
		gap: 8px;
		white-space: nowrap;
	}
	.revizyon-degerler .eski {
		font-size: 13px;
		color: var(--metin-ikincil);
	}
	.revizyon-degerler .yeni {
		font-size: 14px;
		font-weight: 600;
	}
	.revizyon-degerler .yeni.yukselir {
		color: var(--yukselis);
	}
	.revizyon-degerler .yeni.duser {
		color: var(--dusus);
	}
	.konsensus-listesi {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.konsensus-satir {
		display: grid;
		grid-template-columns: 72px minmax(0, 1fr) 150px;
		align-items: center;
		gap: 16px;
		color: var(--metin);
		padding: 4px 0;
	}
	.konsensus-hisse {
		font-family: var(--font-mono);
		font-weight: 500;
		font-size: 14px;
	}
	.konsensus-cubuk {
		height: 10px;
		background: #efece4;
		border-radius: 5px;
		overflow: hidden;
		display: block;
	}
	.konsensus-dolu {
		display: block;
		height: 10px;
		background: var(--marka);
		border-radius: 5px;
	}
	.konsensus-kurumlar {
		grid-column: 2;
		grid-row: 2;
		font-size: 12px;
		color: var(--metin-ikincil);
	}
	.konsensus-satir {
		grid-template-rows: auto auto;
	}
	.konsensus-n {
		grid-column: 3;
		grid-row: 1 / span 2;
		text-align: right;
		font-size: 16px;
		font-weight: 600;
		align-self: center;
	}
	.haber-izgara {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: 16px;
	}
	.haber-kart {
		padding: 18px 20px;
		gap: 10px;
	}
	.haber-listesi {
		margin: 0;
		padding: 0;
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 2px;
	}
	.haber-listesi li {
		display: flex;
		align-items: flex-start;
		gap: 10px;
		padding: 7px 0;
		border-bottom: 1px solid var(--cizgi);
		font-size: 13px;
	}
	.haber-listesi li:last-child {
		border-bottom: 0;
		padding-bottom: 0;
	}
	.haber-listesi .nokta {
		flex-shrink: 0;
		width: 5px;
		height: 5px;
		border-radius: 3px;
		background: var(--kehribar);
		margin-top: 7px;
	}
	.haber-listesi .metin {
		color: var(--metin);
		line-height: 1.4;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.haber-listesi .haber-hisse {
		font-family: var(--font-mono);
		font-weight: 600;
		font-size: 12px;
		flex-shrink: 0;
	}
	.haber-bos {
		margin: 0;
		font-size: 13px;
		color: var(--metin-ikincil);
		padding: 12px 0;
	}
	.kpi-izgara {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 16px;
	}
	.kpi {
		background: var(--kart);
		border: 1px solid var(--kenarlik);
		border-radius: 14px;
		padding: 20px;
		display: flex;
		flex-direction: column;
		gap: 6px;
	}
	.kpi-ad {
		font-size: 13px;
		color: var(--metin-ikincil);
		font-weight: 500;
	}
	.kpi-deger {
		font-family: var(--font-baslik);
		font-size: 38px;
		font-weight: 600;
		line-height: 1;
	}
	.kpi-alt {
		font-size: 12px;
		color: var(--metin-ikincil);
	}
	.izgara {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: 24px;
	}
	.izgara > :global(.genis) {
		grid-column: span 7;
	}
	.izgara > :global(.dar) {
		grid-column: span 5;
	}
	.bos {
		margin: 0;
		font-size: 14px;
		color: var(--metin-ikincil);
		padding: 24px;
		text-align: center;
		background: #faf9f5;
		border-radius: 10px;
	}
	.koyu-metin {
		margin: 0;
		font-size: 14px;
		line-height: 1.5;
		color: #aeb3bf;
	}
	.karne-link {
		color: var(--kehribar);
		font-size: 13px;
		font-weight: 600;
	}
	.karne-listesi {
		display: flex;
		flex-direction: column;
		gap: 12px;
	}
	.karne-satir {
		display: grid;
		grid-template-columns: 20px minmax(0, 1fr) 70px 40px;
		align-items: center;
		gap: 10px;
	}
	.karne-sira {
		font-family: var(--font-baslik);
		font-size: 15px;
		color: #7d8391;
	}
	.karne-kurum {
		font-size: 13px;
		font-weight: 500;
		color: #fff;
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}
	.karne-cubuk {
		height: 8px;
		background: #252c3b;
		border-radius: 4px;
		overflow: hidden;
		display: block;
	}
	.karne-dolu {
		display: block;
		height: 8px;
		background: var(--kehribar);
		border-radius: 4px;
	}
	.karne-yuzde {
		font-size: 14px;
		font-weight: 600;
		color: #fff;
		text-align: right;
	}
	.karne-tum-link {
		margin-top: auto;
		color: var(--kehribar);
		font-weight: 600;
		font-size: 13px;
		align-self: flex-start;
	}
	.metin {
		margin: 0;
		font-size: 14px;
		line-height: 1.55;
		color: #3f434c;
	}

	@media (max-width: 1100px) {
		.kpi-izgara {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}
	}
	@media (max-width: 899px) {
		.haber-izgara {
			grid-template-columns: 1fr;
			gap: 10px;
		}
		.haber-listesi .metin {
			white-space: normal;
		}
		.kpi-izgara {
			gap: 10px;
		}
		.kpi {
			padding: 14px;
		}
		.kpi-deger {
			font-size: 30px;
		}
		.izgara {
			display: flex;
			flex-direction: column;
			gap: 16px;
		}
	}
</style>
