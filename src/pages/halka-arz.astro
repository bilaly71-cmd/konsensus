---
export const prerender = false;

import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Kart from '../components/Kart.astro';
import Rozet from '../components/Rozet.astro';
import TakvimListesi from '../components/TakvimListesi.astro';
import { getDb } from '../lib/db';
import { tureGoreTakvimEtkinlikleri } from '../lib/takvim';

const db = getDb();
const etkinlikler = await tureGoreTakvimEtkinlikleri(db, 'halka_arz');
---

<AnaLayout baslik="Halka arz" aciklama="Yaklaşan ve devam eden halka arzlar.">
	<SayfaBasligi baslik="Halka arz" ust="TAKVİM" aciklama="Yaklaşan ve devam eden halka arzlar.">
		<Rozet>{etkinlikler.length} kayıt</Rozet>
	</SayfaBasligi>

	<Kart baslik="Halka arzlar">
		<TakvimListesi etkinlikler={etkinlikler} bosMesaj="Henüz halka arz girilmedi." />
	</Kart>
</AnaLayout>
