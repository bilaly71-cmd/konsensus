			var mx = toplamAdet(S, kod), qs = enAz(mx, function (q) { return esik(uygula(S, satOp(kod, q)), h); });
			if (qs > 0 && esik(uygula(S, satOp(kod, qs)), h)) hz.push(['Hedef için sat', qs]);
		} else if (p > 0 && need < -1 && from === 'teminat') { var u = o * p; hz.push(['Hedefe kadar serbeste al', u > 0 ? Math.min(row.adet, Math.floor(-need / u)) : row.adet]); }
		DLG.hizli = hz.filter(function (x) { return x[1] != null && x[1] > 0; });
		$('#dlg-hizli').innerHTML = DLG.hizli.map(function (x, i) { return '<button type="button" class="btn ghost" data-hz="' + i + '">' + x[0] + ' (' + tl(x[1]) + ')</button>'; }).join('');
		dlgGuncelle(); var dl = $('#dlg'); if (dl.showModal) dl.showModal(); else dl.setAttribute('open', '');
	}
	function serbestSatisVar(s, kod, q) { return s.kredi + s.faiz >= 1 && satSegmentleri(s, kod, q).some(function (g) { return g.d === 'serbest'; }); }
	function satOp(kod, q) { return { t: serbestSatisVar(S, kod, q) ? 'satOde' : 'sell', kod: kod, adet: q }; }
	function dlgOp() {
		var ey = (document.querySelector('[name=ey]:checked') || {}).value || DLG.eylem, row = bul(S, DLG.from, DLG.kod), a = Math.floor(num($('#dlg-adet').value));
		if (!row || isNaN(a) || a <= 0) return null;
		if (ey === 'sell') { var qa = Math.min(a, toplamAdet(S, DLG.kod)); return { t: ($('#dlg-ode').checked && serbestSatisVar(S, DLG.kod, qa)) ? 'satOde' : 'sell', kod: DLG.kod, adet: qa }; }
		return { t: 'move', kod: DLG.kod, from: DLG.from, to: $('#dlg-hedef').value, adet: Math.min(a, row.adet) };
