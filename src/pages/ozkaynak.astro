		el.innerHTML = '<h2>Ne kadarlık hisse alabilir?</h2><p class="kucuk">Yeni alım kredili yapılırsa kredi depoya %100 girer, borç aynı tutarda artar. Özkaynak hedefin (%' + S.hedef + ') altına düşmeyecek en yüksek tutar hesaplanır (T+2 durumu).</p>'
			+ '<div class="kap-grid"><div class="kap-ana"><div class="l">Mevcut özkaynak ' + pct(m.e) + '</div><div class="v">' + tl(alinabilir) + ' TL</div><div class="n">en fazla yeni alım (özkaynak %' + S.hedef + 'ye kadar)' + (lim != null && x > lim ? ' · kredi limiti sınırlıyor' : '') + '</div></div>'
			+ '<div class="kap-yan"><div class="t"><div class="l">Özkaynağa göre üst sınır</div><div class="vv">' + tl(x) + ' TL</div></div>'
