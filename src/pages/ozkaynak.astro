	}
	function renderOneri() {
		var h = S.hedef, pl = planla(S, h), m = metr(S), e = m.e, el = $('#oneri');
		if (pl.durum === 'bos') { el.innerHTML = '<h2>Hedefe ulaşmak için</h2><p class="kucuk">Depolara hisse ekleyip kredi borcunu girince öneri burada çıkar.</p>'; return; }
		var son = metr(pl.son), bas;
		if (pl.durum === 'fazla') bas = 'Özkaynak hedefin (%' + h + ') üstünde. Aşağıdaki hisseleri serbest depoya alırsan özkaynak ' + pct(e) + ' → ' + pct(son.e) + ' olur, serbest depo değeri ' + tl(depoPiyasa(S, 'serbest')) + ' → ' + tl(depoPiyasa(pl.son, 'serbest')) + ' TL.';
		else if (pl.durum === 'ok' || (pl.steps.length === 0 && pl.durum !== 'yetmez')) bas = 'Özkaynak hedefte (' + pct(e) + '), yapılacak bir şey yok.';
		else if (pl.durum === 'acik') bas = 'Özkaynak ' + pct(e) + ' → hedef %' + h + '. Sıra: serbest depodan teminata çek → serbest nakitle krediyi öde (boşa düşen hisseler teminata) → serbest hisse sat → en son kredi/teminat depodan sat. Plan sonrası (T+2) özkaynak ' + pct(son.e) + '.';
		else bas = 'Eldeki hisselerle hedefe ulaşılamıyor. Plan sonrası özkaynak ' + pct(son.e) + ', hâlâ ' + tl(pl.kalan) + ' TL teminat değeri eksik. Fiyatları ve depoları kontrol et.';
		var satir = pl.steps.map(function (op, i) {
			if (op.t === 'pay') return '<tr><td>' + (i + 1) + '</td><td class="tk">—</td><td>Nakitle kredi öde <span class="kucuk">(kredi depoda boşa düşen hisseler serbeste geçer)</span></td><td class="r">—</td><td class="r">' + tl(op.tutar) + ' TL</td></tr>';
			var aciklama = op.t === 'move' ? (op.to === 'teminat' ? 'Serbest → teminat' : 'Teminat → serbest') : 'SAT <span class="kucuk">(' + satSegmentleri(pl.steps.slice(0, i).reduce(function (t, o) { return uygula(t, o); }, S), op.kod, op.adet).map(function (g) { return g.d + ' ' + tl(g.q); }).join(', ') + ')</span>';
			var tutar = op.adet * px(S, op.kod);
			return '<tr><td>' + (i + 1) + '</td><td class="tk">' + esc(op.kod) + '</td><td>' + aciklama + '</td><td class="r">' + tl(op.adet) + '</td><td class="r">' + tl(tutar) + ' TL</td></tr>';
		}).join('');
		el.innerHTML = '<div class="baslik-satir"><h2>Hedefe ulaşmak için</h2>' + (pl.steps.length ? '<button class="btn" type="button" id="b-plan">Planı uygula</button>' : '') + '</div><p class="oz-ozet">' + bas + '</p>'
			+ (pl.steps.length ? '<div class="tw"><table><thead><tr><th>#</th><th>Hisse</th><th>İşlem</th><th class="r">Adet</th><th class="r">Tutar</th></tr></thead><tbody>' + satir + '</tbody></table></div>' : '')
			+ (pl.steps.some(function (o) { return o.t === 'sell'; }) ? '<p class="kucuk">Satışta önce serbest depo, sonra kredi depo, sonra teminat depo düşer. Serbestten satışın parası nakde gelir (kredi ödemek senin elinde); kredi/teminat depodan satışın parası krediyi otomatik kapatır. Plan T+2 durumunu gösterir.</p>' : '')
			+ (pl.durum === 'fazla' && pl.steps.length ? '<p class="kucuk">Serbest depoya alınacak hisse seçiminde varsayım: oranı düşük olan önce (aynı teminat gevşemesiyle daha çok piyasa değeri serbest kalır). Farklı sıra istersen hisseyi elle sürükle.</p>' : '');
	}
	function renderGecmis() {
		$('#gecmis-kart').hidden = !HIST.length;
		$('#gecmis').innerHTML = HIST.map(function (h) { return '<li>' + esc(h.yazi) + '</li>'; }).join('');
	}
	function render() {
		$('#p-kredi').value = S.kredi ? String(Math.round(S.kredi)).replace(/\B(?=(\d{3})+(?!\d))/g, '.') : '';
		$('#p-faiz').value = S.faiz ? String(Math.round(S.faiz)).replace(/\B(?=(\d{3})+(?!\d))/g, '.') : '';
