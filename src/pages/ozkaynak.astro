		if (row.adet <= 0) { toast(kod + ': T+2 adedi ' + tl(row.adet) + ', taşınacak adet yok.'); return; }
		DLG = { from: from, kod: kod, eylem: to ? 'move' : (from === 'kredi' ? 'sell' : 'move'), to: to || null };
		$('#dlg-baslik').textContent = kod + ' · ' + DEPOLAR.filter(function (x) { return x[0] === from; })[0][1] + ' · ' + tl(row.adet) + ' adet (T+2)';
		var moveOk = from !== 'kredi';
		$('#dlg-eylem').innerHTML = (moveOk ? '<label><input type="radio" name="ey" value="move"> Depo değiştir</label>' : '') + '<label><input type="radio" name="ey" value="sell"> Sat</label>';
		var hedefler = from === 'serbest' ? [['teminat', 'Teminat depo']] : from === 'teminat' ? [['serbest', 'Serbest depo']] : [];
		$('#dlg-hedef').innerHTML = hedefler.map(function (x) { return '<option value="' + x[0] + '">' + x[1] + '</option>'; }).join('');
		if (!moveOk) DLG.eylem = 'sell'; else if (!DLG.to) DLG.to = hedefler[0][0];
		if (DLG.to) $('#dlg-hedef').value = DLG.to;
		document.querySelectorAll('[name=ey]').forEach(function (x) { x.checked = x.value === DLG.eylem; });
		$('#dlg-adet').value = String(row.adet);
		var need = gerek(S, S.hedef / 100), p = px(S, kod), o = rate(kod, from), h = S.hedef / 100, hz = [['Tümü', row.adet]];
		if (p > 0 && need > 1) {
