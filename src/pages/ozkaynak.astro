				var qz = enAz(r.adet, function (q) { return esik(satZinciri(S, r.kod, q).s, h); });
				return esik(satZinciri(S, r.kod, qz).s, h) ? 'Sat ' + tl(qz) + ' adet → nakitle kredi öde' : '<span class="kucuk">tamamı yetmez</span>';
