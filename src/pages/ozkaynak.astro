---
import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Rozet from '../components/Rozet.astro';
---

<AnaLayout baslik="Özkaynak planlayıcı" aciklama="Serbest, kredi ve teminat depoları arasında hisse sürükle; özkaynak oranını ve hedefe ulaşmak için gereken alım/satım adetlerini canlı gör.">
	<SayfaBasligi baslik="Özkaynak planlayıcı" ust="ARAÇLAR VE ARENA" aciklama="Hisseleri depolar arasında sürükle (telefonda “Taşı / Sat” düğmesi). Hesap tarayıcında hesaplanır, hiçbir yere gönderilmez.">
		<Rozet tur="ornek">Fiyatları sen girersin</Rozet>
	</SayfaBasligi>

	<div class="oz">
		<section class="kart param">
			<div class="f"><label for="p-kredi">Kredi borcu (TL)</label><input id="p-kredi" class="n" inputmode="decimal" placeholder="0" /></div>
			<div class="f"><label for="p-faiz">Birikmiş faiz + BSMV (TL)</label><input id="p-faiz" class="n" inputmode="decimal" placeholder="0" /></div>
			<div class="f"><label for="p-hedef">Hedef özkaynak (%)</label><input id="p-hedef" class="n" inputmode="decimal" /></div>
			<div class="f"><label for="p-min">Alt sınır / çağrı (%)</label><input id="p-min" class="n" inputmode="decimal" /></div>
			<div class="aksiyon">
				<button class="btn ghost" type="button" id="b-ornek">Örnek yükle</button>
				<button class="btn ghost" type="button" id="b-sifirla">Sıfırla</button>
			</div>
		</section>

		<details class="kart ice" id="ice">
			<summary>Hesap ekranından içe aktar (yapıştır)</summary>
			<p class="kucuk">Hesap ekranındaki tabloyu (Kredili işlem tutarı, Nakit, Yurtiçi hisse senetleri; “Serbest Depo / Kredi Depo / Teminat Depo” satırlarıyla birlikte) kopyalayıp buraya yapıştır. Depo satırının üstündeki hisseler o depoya yazılır. Adet olarak T+2 sütunu esas alınır, bugünkü adet ayrıca gösterilir; küsuratlı adetlerin küsuratı atılır.</p>
			<textarea id="ice-metin" rows="6" placeholder="Ekrandan kopyaladığın tabloyu buraya yapıştır"></textarea>
			<div class="aksiyon"><button class="btn" type="button" id="ice-btn">İçe aktar</button><span class="kucuk" id="ice-sonuc"></span></div>
		</details>

		<section class="metrikler" id="metrik" aria-live="polite"></section>

		<section class="kart" id="kapasite" aria-live="polite"></section>

		<section class="kart" id="kredili">
			<h2>Kredili alım</h2>
			<p class="kucuk">Kredi kullanıp hisse alırsan hisse kredi depoya %100 değerle girer, kredi borcu artar.</p>
			<div class="satir">
				<div class="f"><label for="k-kod">Hisse</label><input id="k-kod" list="hisseler" placeholder="THYAO" style="text-transform:uppercase" /></div>
				<div class="f"><label for="k-tutar">Tutar (TL)</label><input id="k-tutar" class="n" inputmode="decimal" placeholder="4.000.000" /></div>
				<div class="f"><label for="k-fiyat">Fiyat (TL)</label><input id="k-fiyat" class="n" inputmode="decimal" placeholder="0,00" /></div>
				<button class="btn" type="button" id="k-uygula">Kredili al</button>
			</div>
		</section>

		<section class="kart" id="ode">
			<h2>Kredi öde</h2>
			<p class="kucuk">Serbest nakitle kredi ödersen kredi depoda o tutarda hisse boşa düşer ve serbest depoya geçer; sonra teminat depoya sürükleyebilirsin.</p>
			<div class="satir">
				<div class="f"><label for="o-tutar">Ödenecek tutar (TL)</label><input id="o-tutar" class="n" inputmode="decimal" placeholder="0" /></div>
				<button class="btn" type="button" id="o-uygula">Kredi öde</button>
			</div>
		</section>

		<section class="depolar" id="depolar"></section>

		<section class="kart" id="oneri"></section>

		<section class="kart" id="gecmis-kart" hidden>
			<div class="baslik-satir"><h2>Plan adımları</h2><button class="btn ghost" type="button" id="b-geri">Son adımı geri al</button></div>
			<ol class="adimlar" id="gecmis"></ol>
		</section>

		<p class="yasal">Hesap: özkaynak = (kredi depo değeri + teminat depo değeri − kredi borcu − faiz/BSMV) ÷ (kredi depo değeri + teminat depo değeri). Kredi depo %100, teminat depo hisse başına özkaynak değerleme oranı ile değerlenir; serbest depo hesaba girmez. Oranlar yüklenen Excel dosyasındandır ve kurumun güncel listesiyle karşılaştırılmalıdır. Bu araç bilgi amaçlıdır, yatırım danışmanlığı değildir.</p>
	</div>

	<datalist id="hisseler"></datalist>

	<dialog id="dlg">
		<form method="dialog" id="dlg-form">
			<h3 id="dlg-baslik"></h3>
			<div class="secim" id="dlg-eylem"></div>
			<div class="f" id="dlg-hedef-wrap"><label for="dlg-hedef">Hedef depo</label><select id="dlg-hedef"></select></div>
			<div class="f"><label for="dlg-adet">Adet</label><input id="dlg-adet" class="n" inputmode="numeric" /></div>
			<label class="ode-sec" id="dlg-ode-wrap"><input type="checkbox" id="dlg-ode" checked /> Serbestten satışın parasıyla krediyi öde, boşa düşen hisseleri teminata al (T+2 özkaynağı)</label>
			<div class="aksiyon" id="dlg-hizli"></div>
			<div class="onizleme" id="dlg-onizleme"></div>
			<div class="aksiyon">
				<button class="btn" type="button" id="dlg-tamam">Uygula</button>
				<button class="btn ghost" type="button" id="dlg-iptal">Vazgeç</button>
			</div>
		</form>
	</dialog>
	<div class="toast" id="toast" role="status" hidden></div>
</AnaLayout>

<script is:inline>
	var $ = function (s) { return document.querySelector(s); };
	function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
	function num(v) { if (v == null) return NaN; var s = String(v).trim().replace(/\s/g, ''); if (!s) return NaN; if (s.indexOf(',') > -1) s = s.replace(/\./g, '').replace(',', '.'); else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, ''); return parseFloat(s); }
	function tl(n) { return (n == null || isNaN(n)) ? '—' : Math.round(n).toLocaleString('tr-TR'); }
	function tl2(n) { return (n == null || isNaN(n)) ? '—' : n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
	function pct(x) { return (x == null || isNaN(x)) ? '—' : '%' + (x * 100).toFixed(1).replace('.', ','); }
	var DEPOLAR = [['serbest', 'Serbest depo', 'Alım limiti buradan verilir; özkaynağa girmez'], ['kredi', 'Kredi depo', 'Kredili alınan hisseler · %100 değer'], ['teminat', 'Teminat depo', 'Özkaynak değerleme oranıyla değerlenir']];
	var KEY = 'ozkaynak-v1';
	var ORAN = {};
	var S = null, HIST = [], BASE = null;

	function bos() { return { kredi: 0, faiz: 0, limit: 0, nakit: { t0: 0, t1: 0, t2: 0, t3: 0 }, hedef: 36, min: 35, fiyat: {}, depo: { serbest: [], kredi: [], teminat: [] } }; }
	function clone(o) { return JSON.parse(JSON.stringify(o)); }
	function oran(kod) { return ORAN[kod] ? ORAN[kod].o : 0; }
	function rate(kod, depo) { return depo === 'kredi' ? 1 : oran(kod); }
	function px(s, kod) { return s.fiyat[kod] || 0; }
	/* Serbest depoda eksi (-) adet, satışın teminat / kredi depodan düşeceği anlamına gelir (her depo ayrı değerlendirilir): önce kredi depo, sonra teminat depo */
	function ef(s) {
		if (!s.depo.serbest.some(function (r) { return r.adet < 0; })) return s;
		var n = clone(s);
		n.depo.serbest.forEach(function (r) {
			if (r.adet >= 0) return; var a = -r.adet;
			['kredi', 'teminat'].forEach(function (d) { var x = bul(n, d, r.kod); if (x && a > 0) { var al = Math.min(a, Math.max(0, x.adet)); x.adet -= al; a -= al; } });
			r.adet = 0;
		});
		return n;
	}
	function depoDeger(s, d) { return ef(s).depo[d].reduce(function (t, r) { return t + Math.max(0, r.adet) * px(s, r.kod) * rate(r.kod, d); }, 0); }
	function depoPiyasa(s, d) { return ef(s).depo[d].reduce(function (t, r) { return t + Math.max(0, r.adet) * px(s, r.kod); }, 0); }
	function metr(s) {
		var C = depoDeger(s, 'kredi') + depoDeger(s, 'teminat'), D = s.kredi + s.faiz;
		return { C: C, D: D, e: C > 0 ? (C - D) / C : null, net: C - D };
	}
	function bul(s, d, kod) { return s.depo[d].filter(function (r) { return r.kod === kod; })[0]; }
	/* adet = T+2 adedi (hesaplarda kullanılan), bugun = bugünkü (T0) adet; depo değiştirmede ikisi de değişir, satışta yalnız T+2 düşer */
	function ekle(s, d, kod, adet, bugun) { var r = bul(s, d, kod); if (r) { r.adet += adet; if (r.bugun != null || bugun != null) r.bugun = (r.bugun == null ? r.adet - adet : r.bugun) + (bugun == null ? adet : bugun); } else s.depo[d].push({ kod: kod, adet: adet, bugun: bugun == null ? null : bugun }); }
	function cikar(s, d, kod, adet, sadeceT2) { var r = bul(s, d, kod); if (!r) return; r.adet -= adet; if (r.bugun != null && !sadeceT2) r.bugun -= adet; if (r.adet <= 0 && !(r.bugun > 0)) s.depo[d] = s.depo[d].filter(function (x) { return x !== r; }); }

	/* op: {t:'move',kod,from,to,adet} | {t:'sell',kod,adet} | {t:'pay',tutar} | {t:'buy',kod,adet,fiyat}
	   Satış sırası (sistem kuralı): önce serbest depo (parası serbest nakde gelir, kredi kapanmaz), sonra kredi depo, sonra teminat depo
	   (kredi/teminat depodan satışın parası krediyi otomatik kapatır). Kredi ödeme: nakitten öder, kredi depoda boşa düşen hisseler serbest depoya geçer. */
	var DEPO_SIRA = ['serbest', 'kredi', 'teminat'];
	function toplamAdet(s, kod) { return DEPO_SIRA.reduce(function (t, d) { var r = bul(s, d, kod); return t + (r && r.adet > 0 ? r.adet : 0); }, 0); }
	function satSegmentleri(s, kod, q) { var seg = [], kal = q; DEPO_SIRA.forEach(function (d) { var r = bul(s, d, kod); if (!r || r.adet <= 0 || kal <= 0) return; var a = Math.min(kal, r.adet); seg.push({ d: d, q: a }); kal -= a; }); return seg; }
	function uygula(s, op) {
		var n = clone(s); if (!n.nakit) n.nakit = { t0: 0, t1: 0, t2: 0, t3: 0 };
		if (op.t === 'move') { var rw = bul(n, op.from, op.kod), bg = rw && rw.bugun != null ? Math.min(op.adet, Math.max(0, rw.bugun)) : null; cikar(n, op.from, op.kod, op.adet); ekle(n, op.to, op.kod, op.adet, bg); }
		else if (op.t === 'sell') {
			var p = px(n, op.kod);
			satSegmentleri(n, op.kod, op.adet).forEach(function (sg) {
				cikar(n, sg.d, op.kod, sg.q, true); var gelir = sg.q * p;
				if (sg.d === 'serbest') n.nakit.t0 += gelir;
				else { var k = Math.min(n.kredi, gelir); n.kredi -= k; if (n.limit > 0) n.limit += k; gelir -= k; var f = Math.min(n.faiz, gelir); n.faiz -= f; gelir -= f; n.nakit.t0 += gelir; }
			});
		} else if (op.t === 'satOde') {
			/* serbestten satış + o tutarda kredi öde (T+2 varsayımı) + boşa düşen hisseleri teminata al */
			var sg0 = satSegmentleri(n, op.kod, op.adet).filter(function (g) { return g.d === 'serbest'; })[0], serbestGelir = sg0 ? sg0.q * px(n, op.kod) : 0;
			n = uygula(n, { t: 'sell', kod: op.kod, adet: op.adet });
			var Vo = Math.min(serbestGelir, n.kredi + n.faiz);
			if (Vo >= 1) { var z = odeZinciri(n, Vo); n = z.s; }
		} else if (op.t === 'pay') {
			var V = Math.max(0, Math.min(op.tutar, n.kredi + n.faiz)); n.nakit.t0 -= V;
			var k2 = Math.min(n.kredi, V); n.kredi -= k2; if (n.limit > 0) n.limit += k2; n.faiz -= Math.min(n.faiz, V - k2);
			var sirali = n.depo.kredi.slice().sort(function (a, b) { return oran(b.kod) - oran(a.kod); }), kalan = k2;
			sirali.forEach(function (r) { var pp = px(n, r.kod); if (pp <= 0 || kalan <= 0 || r.adet <= 0) return; var q = Math.min(r.adet, Math.floor(kalan / pp)); if (q <= 0) return; n = uygula(n, { t: 'move', kod: r.kod, from: 'kredi', to: 'serbest', adet: q }); kalan -= q * pp; });
		} else if (op.t === 'buy') { n.fiyat[op.kod] = op.fiyat; ekle(n, 'kredi', op.kod, op.adet, null); n.kredi += op.adet * op.fiyat; if (n.limit) n.limit = Math.max(0, n.limit - op.adet * op.fiyat); }
		return n;
	}
	function serbestFark(a, b) { var out = []; b.depo.serbest.forEach(function (r) { var x = bul(a, 'serbest', r.kod), d = r.adet - (x ? x.adet : 0); if (d > 0) out.push({ kod: r.kod, adet: d }); }); return out; }
	function opYazi(op) {
		var l = { serbest: 'serbest depo', kredi: 'kredi depo', teminat: 'teminat depo' };
		if (op.t === 'move') return op.kod + ': ' + tl(op.adet) + ' adet ' + l[op.from] + ' → ' + l[op.to];
		if (op.t === 'sell') return op.kod + ': ' + tl(op.adet) + ' adet sat (' + satSegmentleri(S, op.kod, op.adet).map(function (g) { return l[g.d].replace(' depo', '') + ' ' + tl(g.q); }).join(', ') + ')';
		if (op.t === 'satOde') return op.kod + ': ' + tl(op.adet) + ' adet sat (' + satSegmentleri(S, op.kod, op.adet).map(function (g) { return l[g.d].replace(' depo', '') + ' ' + tl(g.q); }).join(', ') + ') · serbest satışın parasıyla kredi ödenir, boşa düşenler teminata alınır';
		if (op.t === 'pay') { var fr = serbestFark(S, uygula(S, op)); return 'Kredi öde: ' + tl(op.tutar) + ' TL' + (fr.length ? ' · boşa düşen: ' + fr.map(function (x) { return x.kod + ' ' + tl(x.adet); }).join(', ') : ''); }
		return op.kod + ': ' + tl(op.adet) + ' adet kredili alım (' + tl(op.adet * op.fiyat) + ' TL)';
	}

	/* ---- hedef planı ---- */
	function gerek(s, e) { var m = metr(s); return m.D / (1 - e) - m.C; } /* + : teminat değeri lazım, − : fazla */
	function esik(s, e) { var m = metr(s); return m.C > 0 ? (m.C - m.D) / m.C >= e - 1e-9 : m.D <= 0; }
	function enAz(maxq, f) { maxq = Math.floor(maxq); if (maxq < 1) return 0; if (!f(maxq)) return maxq; var lo = 1, hi = maxq; while (lo < hi) { var mid = Math.floor((lo + hi) / 2); if (f(mid)) hi = mid; else lo = mid + 1; } return lo; }
	/* kredi öde + boşa düşen (oranı olan) hisseleri teminata çek */
	function odeZinciri(s, tutar) {
		var op = { t: 'pay', tutar: tutar }, n = uygula(s, op), ops = [op];
		serbestFark(s, n).forEach(function (x) { if (oran(x.kod) > 0) { var m = { t: 'move', kod: x.kod, from: 'serbest', to: 'teminat', adet: x.adet }; n = uygula(n, m); ops.push(m); } });
		return { s: n, ops: ops };
	}
	/* serbest hisseyi sat → nakitle krediyi öde → boşa düşenleri teminata çek */
	function satZinciri(s, kod, q) {
		var op = { t: 'sell', kod: kod, adet: q }, n = uygula(s, op), ops = [op], V = Math.max(0, Math.min(n.nakit.t0, n.kredi));
		if (V >= 1) { var z = odeZinciri(n, Math.floor(V)); n = z.s; ops = ops.concat(z.ops); }
		return { s: n, ops: ops };
	}
	function planla(s0, hedefPct) {
		var e = hedefPct / 100, s = clone(s0), steps = [], m0 = metr(s), durum;
		if (m0.D <= 0 && m0.C <= 0) return { durum: 'bos', steps: [], son: s, kalan: 0 };
		function uy(ops) { ops.forEach(function (o) { s = uygula(s, o); steps.push(o); }); }
		if (!esik(s, e)) {
			/* 1) serbest depodan teminata çek: oranı yüksek olan önce */
			s.depo.serbest.filter(function (x) { return x.adet > 0 && oran(x.kod) > 0 && px(s, x.kod) > 0; }).sort(function (a, b) { return oran(b.kod) - oran(a.kod); }).forEach(function (r0) {
				if (esik(s, e)) return; var r = bul(s, 'serbest', r0.kod); if (!r) return;
				var q = enAz(r.adet, function (q) { return esik(uygula(s, { t: 'move', kod: r.kod, from: 'serbest', to: 'teminat', adet: q }), e); });
				if (q > 0) uy([{ t: 'move', kod: r.kod, from: 'serbest', to: 'teminat', adet: q }]);
			});
			/* 2) serbest nakitle krediyi öde, kredi depoda boşa düşen hisseleri teminata al */
			if (!esik(s, e) && s.nakit.t0 >= 1 && s.kredi >= 1) {
				var maxV = Math.floor(Math.min(s.nakit.t0, s.kredi)), V = enAz(maxV, function (q) { return esik(odeZinciri(s, q).s, e); });
				if (V >= 1) uy(odeZinciri(s, V).ops);
			}
			/* 3) serbestte kalan hisseleri sat → nakit → öde → teminata çek (oranı düşük olan önce) */
			s.depo.serbest.filter(function (x) { return x.adet > 0 && px(s, x.kod) > 0; }).sort(function (a, b) { return oran(a.kod) - oran(b.kod); }).forEach(function (r0) {
				if (esik(s, e) || s.kredi < 1) return; var r = bul(s, 'serbest', r0.kod); if (!r) return;
				var q = enAz(r.adet, function (q) { return esik(satZinciri(s, r.kod, q).s, e); });
				if (q > 0) uy(satZinciri(s, r.kod, q).ops);
			});
			/* 4) kredi / teminat depodaki hisseyi sat (serbestte yoksa): parası krediyi otomatik kapatır; kredi depo önce düşer */
			var adaylar = {}; ['kredi', 'teminat'].forEach(function (d) { s.depo[d].forEach(function (r) { if (r.adet > 0 && px(s, r.kod) > 0 && !(bul(s, 'serbest', r.kod) && bul(s, 'serbest', r.kod).adet > 0)) adaylar[r.kod] = 1; }); });
			Object.keys(adaylar).sort(function (a, b) { var ra = bul(s, 'kredi', a) ? 1 : oran(a), rb = bul(s, 'kredi', b) ? 1 : oran(b); return ra - rb; }).forEach(function (kod) {
				if (esik(s, e)) return; var mx = toplamAdet(s, kod); if (mx < 1) return;
				var q = enAz(mx, function (q) { return esik(uygula(s, { t: 'sell', kod: kod, adet: q }), e); });
				if (q > 0) uy([{ t: 'sell', kod: kod, adet: q }]);
			});
			durum = esik(s, e) ? (steps.length ? 'acik' : 'ok') : 'yetmez';
			return { durum: durum, steps: steps, son: s, kalan: Math.max(0, gerek(s, e)) };
		}
		var need = gerek(s, e);
		if (need < -1) {
			/* fazla teminat → serbest depoya: oranı düşük olan önce (aynı teminat gevşemesiyle daha çok piyasa değeri serbest kalır) */
			var rel = -need, tm = s.depo.teminat.filter(function (x) { return x.adet > 0 && px(s, x.kod) > 0; }).sort(function (a, b) { return oran(a.kod) - oran(b.kod); });
			for (var k = 0; k < tm.length && rel > 1; k++) {
				var u = oran(tm[k].kod) * px(s, tm[k].kod), qm = u <= 0 ? tm[k].adet : Math.min(tm[k].adet, Math.floor(rel / u)); if (qm <= 0) continue;
				uy([{ t: 'move', kod: tm[k].kod, from: 'teminat', to: 'serbest', adet: qm }]); rel = -gerek(s, e);
			}
			return { durum: 'fazla', steps: steps, son: s, kalan: 0 };
		}
		return { durum: 'ok', steps: [], son: s, kalan: 0 };
	}

	/* ---- kayıt ---- */
	function kaydet() { try { localStorage.setItem(KEY, JSON.stringify({ S: S, BASE: BASE })); } catch (e) {} }
	function yukle() { try { var j = JSON.parse(localStorage.getItem(KEY)); if (j && j.S && j.S.depo) { S = j.S; if (!S.nakit) S.nakit = { t0: 0, t1: 0, t2: 0, t3: 0 }; BASE = j.BASE || clone(S); return true; } } catch (e) {} return false; }
