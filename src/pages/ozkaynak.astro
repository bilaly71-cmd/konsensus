---
import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Rozet from '../components/Rozet.astro';
---

<AnaLayout baslik="Özkaynak planlayıcı" aciklama="Serbest, kredi ve teminat depoları arasında hisse sürükle; özkaynak oranını ve hedefe ulaşmak için gereken alım/satım adetlerini canlı gör.">
	<SayfaBasligi baslik="Özkaynak planlayıcı" ust="ARAÇLAR VE ARENA" aciklama="Hisseleri depolar arasında sürükle ya da komut yaz. Hesap tarayıcında yapılır, hiçbir yere gönderilmez.">
		<Rozet tur="ornek">Simülasyon</Rozet>
	</SayfaBasligi>

	<div class="oz">
		<div class="sticky" id="sticky">
			<div class="sk-row" id="sk-row" aria-live="polite"></div>
			<nav class="tabs" id="tabs" role="tablist" aria-label="Bölümler">
				<button type="button" role="tab" data-tab="hesap" aria-selected="true">Hesap <span class="tab-rozet" id="tab-uy" hidden></span></button>
				<button type="button" role="tab" data-tab="alim" aria-selected="false">Alım</button>
				<button type="button" role="tab" data-tab="nakit" aria-selected="false">Nakit</button>
				<button type="button" role="tab" data-tab="risk" aria-selected="false">Risk</button>
				<button type="button" role="tab" data-tab="ozet" aria-selected="false">Özet</button>
			</nav>
		</div>

		<!-- ============ HESAP ============ -->
		<div class="panel" data-panel="hesap">
			<section class="komut">
				<input id="cmd" autocomplete="off" aria-label="Hızlı komut" placeholder="Komut yaz ve Enter’a bas:  KCHOL 5000 sat · EREGL 10000 çek · öde 500k · al THYAO 2m 312,5 · atl 5m · hedef 40 · plan · geri   ( / tuşu buraya odaklar )" />
				<div class="kucuk" id="cmd-sonuc"></div>
				<details class="kucuk"><summary>Komut listesi</summary>
					<ul class="komut-liste">
						<li><b>KOD 5000 sat</b> — 5.000 adet sat (tutar için <b>KOD 2m tl sat</b>; <b>hepsi</b> = tümü). Serbestteyse satış parasıyla kredi ödenir (T+2).</li>
						<li><b>KOD 5000 çek</b> — serbest → teminat · <b>KOD 5000 serbest</b> — teminat → serbest</li>
						<li><b>öde 500k</b> — nakitle kredi öde · <b>al KOD 2m 312,5</b> — 2 mio TL kredili alım</li>
						<li><b>atl 5m</b> — ATL var, tutar 5 mio · <b>atl yok</b> · <b>hedef 40</b> · <b>fiyat KOD 12,5</b> · <b>fiyatlar</b> (Yahoo) · <b>plan</b> · <b>geri</b> · <b>başa</b></li>
						<li>Sayılar: <b>500k</b> = 500 bin, <b>2m</b> = 2 milyon, <b>1.250.000</b></li>
					</ul>
				</details>
			</section>

			<section class="girdi-panel" id="girdi-panel" aria-label="Hesap girdileri">
				<div class="gp-ust"><h2>Hesap girdileri</h2><span class="kucuk" id="girdi-ozet"></span></div>
				<div class="param">
					<div class="f"><label for="p-kredi">Kredi borcu (TL)</label><input id="p-kredi" class="n" inputmode="decimal" placeholder="0" /></div>
					<div class="f"><label for="p-faiz">Birikmiş faiz + BSMV (TL)</label><input id="p-faiz" class="n" inputmode="decimal" placeholder="0" /></div>
					<div class="f"><label for="p-hedef">Hedef özkaynak (%)</label><input id="p-hedef" class="n" inputmode="decimal" /></div>
					<div class="f"><label for="p-min">Alt sınır / çağrı (%)</label><input id="p-min" class="n" inputmode="decimal" /></div>
				</div>
				<div class="hedef-cipler" id="hedef-cipler" role="group" aria-label="Hedef özkaynak"></div>
				<details class="gp-ice" id="girdi" open>
					<summary>Hesap ekranından içe aktar · örnek yükle · sıfırla</summary>
					<div class="ice" id="ice">
						<label for="ice-metin" class="kucuk"><b>Hesap ekranından içe aktar</b> — tabloyu (Kredili işlem tutarı, Nakit, Yurtiçi hisse senetleri; “Serbest / Kredi / Teminat Depo” satırlarıyla) kopyalayıp yapıştır. Adet olarak T+2 esas alınır, küsurat atılır.</label>
						<textarea id="ice-metin" rows="4" placeholder="Ekrandan kopyaladığın tabloyu buraya yapıştır"></textarea>
						<div class="aksiyon"><button class="btn" type="button" id="ice-btn">İçe aktar</button><span class="kucuk" id="ice-sonuc"></span></div>
					</div>
					<div class="aksiyon girdi-alt">
						<button class="btn ghost" type="button" id="b-ornek">Örnek yükle</button>
						<button class="btn ghost" type="button" id="b-basa">Başlangıca dön</button>
						<button class="btn ghost" type="button" id="b-sifirla">Sıfırla</button>
					</div>
				</details>
			</section>

			<section class="metrikler" id="metrik" aria-live="polite"></section>

			<section class="depolar" id="depolar"></section>

			<section class="kart" id="oneri"></section>

			<details class="kart" id="uyari-d"><summary>Kontrol <span id="uyari-ozet" class="kucuk"></span></summary><div id="uyari"></div></details>

			<details class="kart" id="gecmis-kart" hidden>
				<summary>Plan adımları <span class="kucuk">(geri alınabilir)</span></summary>
				<div class="aksiyon"><button class="btn ghost" type="button" id="b-geri">Son adımı geri al</button></div>
				<ol class="adimlar" id="gecmis"></ol>
			</details>
		</div>

		<!-- ============ ALIM ============ -->
		<div class="panel" data-panel="alim" hidden>
			<section class="kart atl-kutu" id="atl-kutu">
				<h2>Alım limiti</h2>
				<div class="atl-satir">
					<label class="atl-sec"><input type="checkbox" id="atl-var" /> <b>ATL var</b> <span class="kucuk">(hesaba tanımlı açık takas limiti; işaretliysa alım limiti bu olur)</span></label>
					<div class="f"><label for="atl-tutar">ATL tutarı (TL)</label><input id="atl-tutar" class="n" inputmode="decimal" placeholder="örn. 5.000.000" /></div>
				</div>
				<p class="kucuk" id="atl-not"></p>
			</section>
			<section class="kart" id="kapasite" aria-live="polite"></section>
			<section class="kart" id="islem">
				<h2>İşlemler</h2>
				<div class="islem-grid">
					<div>
						<h3>Kredili alım</h3>
						<p class="kucuk">Hisse kredi depoya %100 girer, borç artar.</p>
						<div class="satir">
							<div class="f"><label for="k-kod">Hisse</label><input id="k-kod" list="hisseler" placeholder="THYAO" style="text-transform:uppercase" /></div>
							<div class="f"><label for="k-tutar">Tutar (TL)</label><input id="k-tutar" class="n" inputmode="decimal" placeholder="4.000.000" /></div>
							<div class="f"><label for="k-fiyat">Fiyat (TL)</label><input id="k-fiyat" class="n" inputmode="decimal" placeholder="0,00" /></div>
							<button class="btn" type="button" id="k-uygula">Kredili al</button>
						</div>
					</div>
					<div>
						<h3>Kredi öde</h3>
						<p class="kucuk">Nakitle öde; kredi depoda boşa düşen hisseler serbeste geçer.</p>
						<div class="satir">
							<div class="f"><label for="o-tutar">Tutar (TL)</label><input id="o-tutar" class="n" inputmode="decimal" placeholder="0" /></div>
							<button class="btn" type="button" id="o-uygula">Kredi öde</button>
						</div>
					</div>
				</div>
			</section>
		</div>

		<!-- ============ NAKİT ============ -->
		<div class="panel" data-panel="nakit" hidden>
			<section class="kart" id="nakit"></section>
		</div>

		<!-- ============ RİSK ============ -->
		<div class="panel" data-panel="risk" hidden>
			<section class="kart" id="stres"></section>
		</div>

		<!-- ============ ÖZET ============ -->
		<div class="panel" data-panel="ozet" hidden>
			<section class="kart" id="ozet"></section>
			<section class="kart" id="senaryo"></section>
			<details class="kart" id="araclar">
				<summary>Araçlar: fiyat güncelle, oran listesi</summary>
				<div class="arac-grid">
					<div>
						<h3>Fiyatlar</h3>
						<div class="aksiyon fy-canli"><button class="btn" type="button" id="fy-cek">Yahoo’dan güncelle</button><span class="kucuk" id="fy-durum"></span></div>
						<p class="kucuk">Yahoo Finance’tan gecikmeli, yakın fiyat (resmi olmayan kaynak; kontrol et). Ya da elle: her satıra “KOD fiyat”.</p>
						<textarea id="tf-metin" rows="4" placeholder="THYAO 312,5&#10;EREGL 25,4"></textarea>
						<div class="aksiyon"><button class="btn ghost" type="button" id="tf-btn">Yapıştırdığım fiyatları uygula</button><span class="kucuk" id="tf-sonuc"></span></div>
					</div>
					<div>
						<h3>Oran listesi</h3>
						<p class="kucuk" id="oran-durum"></p>
						<p class="kucuk">Kurumun Excel dosyasını (“Hisse Kodu” ve “Özkaynak Değerleme Oranı” sütunlu) seç; oranlar bu tarayıcıda saklanır.</p>
						<div class="aksiyon"><input type="file" id="oran-dosya" accept=".xlsx" /><button class="btn ghost" type="button" id="oran-sifirla">Varsayılana dön</button></div>
						<span class="kucuk" id="oran-sonuc"></span>
					</div>
				</div>
			</details>
		</div>

		<p class="yasal">Hesap: özkaynak = (kredi depo değeri + teminat depo değeri − kredi borcu − faiz/BSMV) ÷ (kredi depo değeri + teminat depo değeri). Kredi depo %100, teminat depo hisse başına özkaynak değerleme oranı ile değerlenir; serbest depo hesaba girmez. Alım limiti: ATL varsa ATL tutarı, yoksa serbest depo teminatı × 5. Oranlar yüklenen Excel dosyasındandır ve kurumun güncel listesiyle karşılaştırılmalıdır. Bu araç bilgi amaçlıdır, yatırım danışmanlığı değildir.</p>
	</div>

	<datalist id="hisseler"></datalist>

	<dialog id="dlg">
		<form method="dialog" id="dlg-form">
			<h3 id="dlg-baslik"></h3>
			<div class="secim" id="dlg-eylem"></div>
			<div class="f" id="dlg-hedef-wrap"><label for="dlg-hedef">Hedef depo</label><select id="dlg-hedef"></select></div>
			<div class="f"><label for="dlg-adet">Adet</label><input id="dlg-adet" class="n" inputmode="numeric" /></div>
			<label class="ode-sec" id="dlg-ode-wrap"><input type="checkbox" id="dlg-ode" checked /> Serbestten satışın parasıyla krediyi öde, boşa düşen hisseleri teminata al (T+2 özkaynağı)</label>
			<label class="ode-sec" id="dlg-oto-wrap"><input type="checkbox" id="dlg-oto" /> Serbestte yetmeyen (açık) kısım için satış parasıyla kredi ödensin <span class="kucuk">(özkaynak alt sınırın altındaysa sistem otomatik yapar)</span></label>
			<div class="aksiyon" id="dlg-hizli"></div>
			<div class="onizleme" id="dlg-onizleme"></div>
			<div class="aksiyon">
				<button class="btn" type="button" id="dlg-tamam">Uygula</button>
				<button class="btn ghost" type="button" id="dlg-iptal">Vazgeç</button>
			</div>
		</form>
	</dialog>
	<div class="toast" id="toast" role="status" hidden></div>
</AnaLayout>

<script is:inline>
	var $ = function (s) { return document.querySelector(s); };
	function esc(s) { return String(s == null ? '' : s).replace(/[&<>"]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c]; }); }
	function num(v) { if (v == null) return NaN; var s = String(v).trim().replace(/\s/g, ''); if (!s) return NaN; if (s.indexOf(',') > -1) s = s.replace(/\./g, '').replace(',', '.'); else if (/^\d{1,3}(\.\d{3})+$/.test(s)) s = s.replace(/\./g, ''); return parseFloat(s); }
	function tl(n) { return (n == null || isNaN(n)) ? '—' : Math.round(n).toLocaleString('tr-TR'); }
	function tl2(n) { return (n == null || isNaN(n)) ? '—' : n.toLocaleString('tr-TR', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }
	function pct(x) { return (x == null || isNaN(x)) ? '—' : '%' + (x * 100).toFixed(1).replace('.', ','); }
	var DEPOLAR = [['serbest', 'Serbest depo', 'Alım limiti buradan verilir; özkaynağa girmez'], ['kredi', 'Kredi depo', 'Kredili alınan hisseler · %100 değer'], ['teminat', 'Teminat depo', 'Özkaynak değerleme oranıyla değerlenir']];
	var KEY = 'ozkaynak-v1';
	var ORAN = {};
	var S = null, HIST = [], BASE = null;

	function bos() { return { kredi: 0, faiz: 0, limit: 0, nakit: { t0: 0, t1: 0, t2: 0, t3: 0 }, satisNakit: 0, satisToplam: 0, bekleyenOdeme: 0, atl: { var: false, tutar: 0 }, fiyatMeta: {}, kapanis: {}, hedef: 36, min: 35, fiyat: {}, depo: { serbest: [], kredi: [], teminat: [] } }; }
	function hazirla(x) { if (!x.nakit) x.nakit = { t0: 0, t1: 0, t2: 0, t3: 0 }; if (!x.atl) x.atl = { var: false, tutar: 0 }; if (!x.fiyatMeta) x.fiyatMeta = {}; if (!x.kapanis) x.kapanis = {}; if (x.satisNakit == null) x.satisNakit = 0; if (x.satisToplam == null) x.satisToplam = 0; if (x.bekleyenOdeme == null) x.bekleyenOdeme = 0; return x; }
	function clone(o) { return JSON.parse(JSON.stringify(o)); }
	function oran(kod) { return ORAN[kod] ? ORAN[kod].o : 0; }
	function rate(kod, depo) { return depo === 'kredi' ? 1 : oran(kod); }
	function px(s, kod) { return s.fiyat[kod] || 0; }
	/* Serbest depoda eksi (-) adet, satışın teminat / kredi depodan düşeceği anlamına gelir (her depo ayrı değerlendirilir): önce kredi depo, sonra teminat depo */
	function ef(s) {
		if (!s.depo.serbest.some(function (r) { return r.adet < 0; })) return s;
		var n = clone(s);
		n.depo.serbest.forEach(function (r) {
			if (r.adet >= 0) return; var a = -r.adet;
			['kredi', 'teminat'].forEach(function (d) { var x = bul(n, d, r.kod); if (x && a > 0) { var al = Math.min(a, Math.max(0, x.adet)); x.adet -= al; a -= al; } });
			r.adet = 0;
		});
		return n;
	}
	function depoDeger(s, d) { return ef(s).depo[d].reduce(function (t, r) { return t + Math.max(0, r.adet) * px(s, r.kod) * rate(r.kod, d); }, 0); }
	function depoPiyasa(s, d) { return ef(s).depo[d].reduce(function (t, r) { return t + Math.max(0, r.adet) * px(s, r.kod); }, 0); }
	function metr(s) {
		var C = depoDeger(s, 'kredi') + depoDeger(s, 'teminat'), D = Math.max(0, s.kredi + s.faiz - (s.bekleyenOdeme || 0));
		return { C: C, D: D, e: C > 0 ? (C - D) / C : null, net: C - D };
	}
	function bul(s, d, kod) { return s.depo[d].filter(function (r) { return r.kod === kod; })[0]; }
	/* adet = T+2 adedi (hesaplarda kullanılan), bugun = bugünkü (T0) adet; depo değiştirmede ikisi de değişir, satışta yalnız T+2 düşer */
	function ekle(s, d, kod, adet, bugun) { var r = bul(s, d, kod); if (r) { r.adet += adet; if (r.bugun != null || bugun != null) r.bugun = (r.bugun == null ? r.adet - adet : r.bugun) + (bugun == null ? adet : bugun); } else s.depo[d].push({ kod: kod, adet: adet, bugun: bugun == null ? null : bugun }); }
	function cikar(s, d, kod, adet, sadeceT2) { var r = bul(s, d, kod); if (!r) return; r.adet -= adet; if (r.bugun != null && !sadeceT2) r.bugun -= adet; if (r.adet <= 0 && !(r.bugun > 0)) s.depo[d] = s.depo[d].filter(function (x) { return x !== r; }); }

	/* op: {t:'move',kod,from,to,adet} | {t:'sell',kod,adet} | {t:'pay',tutar} | {t:'buy',kod,adet,fiyat}
	   Satış sırası (sistem kuralı): önce serbest depo (parası serbest nakde gelir, kredi kapanmaz), sonra kredi depo, sonra teminat depo
	   (kredi/teminat depodan satışın parası krediyi otomatik kapatır). Kredi ödeme: nakitten öder, kredi depoda boşa düşen hisseler serbest depoya geçer. */
	var DEPO_SIRA = ['serbest', 'kredi', 'teminat'];
	/* Etkin (T+2) elde tutulan adet: serbestteki eksi adetler kredi, sonra teminat depodan düşülmüş halde */
	function hold(s, d, kod) { var r = bul(ef(s), d, kod); return r && r.adet > 0 ? r.adet : 0; }
	function toplamAdet(s, kod) { var e = ef(s); return DEPO_SIRA.reduce(function (t, d) { var r = bul(e, d, kod); return t + (r && r.adet > 0 ? r.adet : 0); }, 0); }
	function satSegmentleri(s, kod, q) { var e = ef(s), seg = [], kal = q; DEPO_SIRA.forEach(function (d) { var r = bul(e, d, kod); if (!r || r.adet <= 0 || kal <= 0) return; var a = Math.min(kal, r.adet); seg.push({ d: d, q: a }); kal -= a; }); return seg; }
	/* Satış: sistemde satış önce serbest depoya yazılır; yetmezse serbest depo EKSİ lota düşer ve T+2'de kredi (önce), sonra teminat depodan kapanır.
	   Satış parası T+2 nakdine yazılır. Açık kısım için (özkaynak alt sınırın altındaysa) sistem parayla krediyi otomatik öder: op.oto */
	function uygula(s, op) {
		var n = clone(s); if (!n.nakit) n.nakit = { t0: 0, t1: 0, t2: 0, t3: 0 };
		if (op.t === 'move') { var rw = bul(n, op.from, op.kod), bg = rw && rw.bugun != null ? Math.min(op.adet, Math.max(0, rw.bugun)) : null; cikar(n, op.from, op.kod, op.adet); ekle(n, op.to, op.kod, op.adet, bg); }
		else if (op.t === 'sell') {
			var p = px(n, op.kod), row = bul(n, 'serbest', op.kod);
			if (!row) { row = { kod: op.kod, adet: 0, bugun: null }; n.depo.serbest.push(row); }
			var acik = Math.max(0, op.adet - Math.max(0, row.adet)); row.adet -= op.adet;
			var gelir = op.adet * p; n.satisNakit = (n.satisNakit || 0) + gelir; n.satisToplam = (n.satisToplam || 0) + gelir;
			if (op.oto && acik > 0) { var od = Math.min(acik * p, Math.max(0, n.kredi + n.faiz - (n.bekleyenOdeme || 0))); n.bekleyenOdeme = (n.bekleyenOdeme || 0) + od; if (n.limit > 0) n.limit += od; }
			if (row.adet === 0 && !(row.bugun > 0)) n.depo.serbest = n.depo.serbest.filter(function (x) { return x !== row; });
		} else if (op.t === 'satOde') {
			/* serbestten satış + o tutarda kredi öde (T+2 varsayımı) + boşa düşen hisseleri teminata al */
			var sg0 = satSegmentleri(n, op.kod, op.adet).filter(function (g) { return g.d === 'serbest'; })[0], serbestGelir = sg0 ? sg0.q * px(n, op.kod) : 0;
			n = uygula(n, { t: 'sell', kod: op.kod, adet: op.adet, oto: op.oto });
			/* satış parası önce serbest nakit eksisini kapatır; krediye ancak nakit artıya geçen kısım ödenir */
			var Vo = Math.min(serbestGelir, Math.max(0, cumNakit(n, 2)), Math.max(0, n.kredi + n.faiz - (n.bekleyenOdeme || 0)));
			if (Vo >= 1) { var z = odeZinciri(n, Vo); n = z.s; }
		} else if (op.t === 'pay') {
			var V = Math.max(0, Math.min(op.tutar, n.kredi + n.faiz)); nakitDus(n, V);
			var k2 = Math.min(n.kredi, V); n.kredi -= k2; if (n.limit > 0) n.limit += k2; n.faiz -= Math.min(n.faiz, V - k2);
			/* kredi depoda boşa düşen hisseler: hangisinin düşeceğini sistem belirler; orantılı (ortalama) dağıtılır */
			var E = ef(n), krow = E.depo.kredi.filter(function (r) { return r.adet > 0 && px(n, r.kod) > 0; }), Vk = krow.reduce(function (t, r) { return t + r.adet * px(n, r.kod); }, 0);
			if (Vk > 0 && k2 > 0) krow.forEach(function (r) { var pp = px(n, r.kod), q = Math.min(r.adet, Math.floor(k2 * (r.adet * pp / Vk) / pp)); if (q > 0) n = uygula(n, { t: 'move', kod: r.kod, from: 'kredi', to: 'serbest', adet: q }); });
		} else if (op.t === 'buy') { n.fiyat[op.kod] = op.fiyat; ekle(n, 'kredi', op.kod, op.adet, null); n.kredi += op.adet * op.fiyat; if (n.limit) n.limit = Math.max(0, n.limit - op.adet * op.fiyat); }
		return n;
	}
	/* Kümülatif nakit: T+2'den itibaren plan satışları girer, otomatik kredi ödemesi çıkar */
