			+ '<div class="f kap-f"><label for="kap-fiyat">Hisse fiyatı (adet için, isteğe bağlı)</label><input id="kap-fiyat" class="n" inputmode="decimal" placeholder="0,00" value="' + (fy > 0 ? String(fy).replace('.', ',') : '') + '" /></div>'
			+ '<p class="kap-cumle">Özkaynak ' + pct(m.e) + '; %' + S.hedef + ' hedefe göre <b>en fazla ' + tl(alinabilir) + ' TL</b> kredili alım yapılabilir' + adetYazi + '.</p>' + (alt ? '<p class="kucuk dusus">' + alt + '</p>' : '');
