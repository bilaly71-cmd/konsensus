---
export const prerender = false;

import AnaLayout from '../layouts/AnaLayout.astro';
import SayfaBasligi from '../components/SayfaBasligi.astro';
import Kart from '../components/Kart.astro';
import Rozet from '../components/Rozet.astro';
import TakvimListesi from '../components/TakvimListesi.astro';
import { getDb } from '../lib/db';
import { tureGoreTakvimEtkinlikleri } from '../lib/takvim';

const db = getDb();
const etkinlikler = await tureGoreTakvimEtkinlikleri(db, 'spk_bulten');
---

<AnaLayout baslik="SPK bülteni" aciklama="Haftalık SPK bülteninin özeti.">
	<SayfaBasligi baslik="SPK bülteni" ust="TAKVİM" aciklama="Haftalık SPK bülteninin özeti.">
		<Rozet>{etkinlikler.length} kayıt</Rozet>
	</SayfaBasligi>

	<Kart baslik="Bülten özetleri">
		<TakvimListesi etkinlikler={etkinlikler} bosMesaj="Henüz SPK bülteni özeti girilmedi." />
	</Kart>
</AnaLayout>
