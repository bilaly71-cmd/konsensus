---
export const prerender = false;

import AnaLayout from '../../layouts/AnaLayout.astro';
import SayfaBasligi from '../../components/SayfaBasligi.astro';
import Kart from '../../components/Kart.astro';
import Rozet from '../../components/Rozet.astro';
import Buton from '../../components/Buton.astro';
import { bugunIstanbul } from '../../lib/tarih';

const bugun = bugunIstanbul();
---

<AnaLayout baslik="Yönetim paneli">
	<SayfaBasligi baslik="Yönetim paneli" ust="PANEL" aciklama="Bülteni yapıştır, sistem alanlara ayırsın, kontrol edip kaydet.">
		<Rozet tur="marka">Sadece Bilal</Rozet>
	</SayfaBasligi>

	<Kart baslik="1. Bülteni yapıştır" altBaslik="Kurumdan gelen metni olduğu gibi yapıştır — sistem alanlara ayırmaya çalışır">
		<div class="tarih-alan">
			<label>
				<span>Öneri tarihi</span>
				<input type="date" id="tarih" value={bugun} />
			</label>
		</div>
		<p class="ipucu">
			Serbest metin de olur ("Garanti BBVA Yatırım: THYAO için 330 TL girişle 365 TL hedef, 310 TL
			stop, günlük işlem"), Excel/Sheets'ten kopyalanmış satırlar da. Birden fazla öneriyi alt alta
			veya boş satırla ayırarak yapıştırabilirsin — her biri ayrı satır olarak ayrıştırılır.
		</p>
		<textarea id="bulten" rows="7" placeholder="Bülteni buraya yapıştır..."></textarea>
		<div class="dugmeler">
			<Buton id="ayristirDugme" type="button">Ayrıştır ve önizle</Buton>
		</div>
	</Kart>

	<details class="toplu">
		<summary>Tek satırı elle, kutu kutu eklemek istersen (isteğe bağlı)</summary>
		<div class="toplu-icerik">
			<div class="form-izgara">
				<label>
					<span>Kurum *</span>
					<input type="text" id="fKurum" placeholder="örn. Garanti BBVA Yatırım" />
				</label>
				<label>
					<span>Hisse kodu *</span>
					<input type="text" id="fHisse" placeholder="örn. THYAO" />
				</label>
				<label>
					<span>Tür</span>
					<select id="fTur">
						<option>Günlük</option>
						<option>Haftalık</option>
						<option>Model portföy</option>
						<option>Takip listesi</option>
					</select>
				</label>
				<label>
					<span>Giriş</span>
					<input type="text" id="fGiris" placeholder="isteğe bağlı" />
				</label>
				<label>
					<span>Hedef *</span>
					<input type="text" id="fHedef" placeholder="örn. 365" />
				</label>
				<label>
					<span>Stop</span>
					<input type="text" id="fStop" placeholder="isteğe bağlı" />
				</label>
				<label>
					<span>Potansiyel</span>
					<input type="text" id="fPotansiyel" placeholder="örn. +%10,6" />
				</label>
			</div>
			<p id="formHata" class="durum-mesaji hata"></p>
			<div class="dugmeler">
				<Buton id="ekleDugme" tur="ikincil" type="button">Satır ekle</Buton>
			</div>
		</div>
	</details>

	<Kart baslik="2. Kontrol et ve onayla" altBaslik="Otomatik ayrıştırılan alanları buradan düzeltebilirsin">
		<div id="onizlemeBos" class="bos">Henüz satır eklemedin.</div>
		<div id="onizlemeSarici" class="tablo-sarici" style="display:none">
			<table>
				<thead>
					<tr>
						<th></th>
						<th>Kurum</th>
						<th>Hisse</th>
						<th>Tür</th>
						<th>Giriş</th>
						<th>Hedef</th>
						<th>Stop</th>
						<th>Potansiyel</th>
						<th></th>
					</tr>
				</thead>
				<tbody id="onizlemeGovde"></tbody>
			</table>
		</div>
		<div class="dugmeler">
			<Buton id="kaydetDugme" type="button">Onayla ve kaydet</Buton>
			<Buton id="temizleDugme" tur="metin" type="button">Listeyi temizle</Buton>
		</div>
		<p id="durumMesaji" class="durum-mesaji"></p>
	</Kart>

	<Kart baslik="Bugün kaydedilenler" altBaslik="Bu tarih için veritabanındaki öneriler">
		<Fragment slot="sag"><button type="button" id="yenileDugme" class="yenile">Yenile</button></Fragment>
		<div id="kayitliBos" class="bos">Yükleniyor...</div>
		<div id="kayitliSarici" class="tablo-sarici" style="display:none">
			<table>
				<thead>
					<tr><th>Kurum</th><th>Hisse</th><th>Tür</th><th>Giriş</th><th>Hedef</th><th>Stop</th><th>Potansiyel</th><th></th></tr>
				</thead>
				<tbody id="kayitliGovde"></tbody>
			</table>
		</div>
	</Kart>

	<Kart baslik="3. Öneri karnesi — sonuç işaretle" altBaslik="Gerçek fiyat verisi yok; sonucu buradan sen işaretlersin">
		<Fragment slot="sag"><button type="button" id="bekleyenYenileDugme" class="yenile">Yenile</button></Fragment>
		<div id="bekleyenBos" class="bos">Yükleniyor...</div>
		<div id="bekleyenSarici" class="tablo-sarici" style="display:none">
			<table>
				<thead>
					<tr><th>Tarih</th><th>Kurum</th><th>Hisse</th><th>Hedef</th><th>Stop</th><th class="sag">Sonuç</th></tr>
				</thead>
				<tbody id="bekleyenGovde"></tbody>
			</table>
		</div>
	</Kart>

	<Kart baslik="4. Fon hareketi ekle" altBaslik="Aylık portföy raporlarından — TEFAS/KAP'tan elle gireceksin">
		<div class="form-izgara">
			<label>
				<span>Dönem (ay) *</span>
				<input type="text" id="fonDonem" placeholder="örn. 2026-08" />
			</label>
			<label>
				<span>Fon adı *</span>
				<input type="text" id="fonAdi" placeholder="örn. Ak Portföy Hisse Senedi Fonu" />
			</label>
			<label>
				<span>Hisse kodu *</span>
				<input type="text" id="fonHisse" placeholder="örn. THYAO" />
			</label>
			<label>
				<span>Hareket</span>
				<select id="fonHareket">
					<option value="yeni">Yeni aldı</option>
					<option value="artirdi">Artırdı</option>
					<option value="azaltti">Azalttı</option>
					<option value="cikti">Tamamen çıktı</option>
				</select>
			</label>
			<label>
				<span>Ağırlık</span>
				<input type="text" id="fonAgirlik" placeholder="isteğe bağlı, örn. %3,2" />
			</label>
		</div>
		<p id="fonHata" class="durum-mesaji hata"></p>
		<div class="dugmeler">
			<Buton id="fonEkleDugme" tur="ikincil" type="button">Fon hareketi ekle</Buton>
		</div>
		<div id="fonListesi" class="fon-listesi"></div>
	</Kart>

	<Kart baslik="5. Takvim etkinliği ekle" altBaslik="Temettü, bedelsiz, genel kurul, halka arz, SPK bülteni">
		<div class="form-izgara">
			<label>
				<span>Tarih *</span>
				<input type="date" id="takvimTarih" />
			</label>
			<label>
				<span>Tür</span>
				<select id="takvimTur">
					<option value="temettu">Temettü</option>
					<option value="bedelsiz">Bedelsiz</option>
					<option value="genel_kurul">Genel kurul</option>
					<option value="halka_arz">Halka arz</option>
					<option value="spk_bulten">SPK bülteni</option>
					<option value="diger">Diğer</option>
				</select>
			</label>
			<label>
				<span>Hisse</span>
				<input type="text" id="takvimHisse" placeholder="isteğe bağlı" />
			</label>
			<label>
				<span>Başlık *</span>
				<input type="text" id="takvimBaslik" placeholder="örn. Net %10 temettü dağıtımı" />
			</label>
		</div>
		<p id="takvimHata" class="durum-mesaji hata"></p>
		<div class="dugmeler">
			<Buton id="takvimEkleDugme" tur="ikincil" type="button">Etkinlik ekle</Buton>
		</div>
		<div id="takvimListesi" class="fon-listesi"></div>
	</Kart>

	<script>
		import { bulteniAyristir, type TaslakSatir } from '../../lib/ayristir';

		const tarihEl = document.getElementById('tarih') as HTMLInputElement;

		const bultenEl = document.getElementById('bulten') as HTMLTextAreaElement;
		const ayristirDugmeEl = document.getElementById('ayristirDugme')!;

		const fKurum = document.getElementById('fKurum') as HTMLInputElement;
		const fHisse = document.getElementById('fHisse') as HTMLInputElement;
		const fTur = document.getElementById('fTur') as HTMLSelectElement;
		const fGiris = document.getElementById('fGiris') as HTMLInputElement;
		const fHedef = document.getElementById('fHedef') as HTMLInputElement;
		const fStop = document.getElementById('fStop') as HTMLInputElement;
		const fPotansiyel = document.getElementById('fPotansiyel') as HTMLInputElement;
		const formHataEl = document.getElementById('formHata')!;
		const ekleDugmeEl = document.getElementById('ekleDugme')!;

		const onizlemeBosEl = document.getElementById('onizlemeBos')!;
		const onizlemeSariciEl = document.getElementById('onizlemeSarici')!;
		const onizlemeGovdeEl = document.getElementById('onizlemeGovde')!;
		const kaydetDugmeEl = document.getElementById('kaydetDugme')!;
		const temizleDugmeEl = document.getElementById('temizleDugme')!;
		const durumMesajiEl = document.getElementById('durumMesaji')!;

		const kayitliBosEl = document.getElementById('kayitliBos')!;
		const kayitliSariciEl = document.getElementById('kayitliSarici')!;
		const kayitliGovdeEl = document.getElementById('kayitliGovde')!;
		const yenileDugmeEl = document.getElementById('yenileDugme')!;

		type Satir = TaslakSatir;
		let satirlar: Satir[] = [];

		const ALANLAR: (keyof Satir)[] = ['kurum', 'hisse', 'tur', 'giris', 'hedef', 'stop', 'potansiyel'];

		function hucreYaz(satir: Satir, alan: keyof Satir, index: number): string {
			const deger = String(satir[alan] ?? '');
			const eksikMi = (alan === 'kurum' || alan === 'hisse' || alan === 'hedef') && !deger;
			return `<input type="text" class="hucre ${eksikMi ? 'eksik' : ''}" data-index="${index}" data-alan="${alan}" value="${deger.replace(/"/g, '&quot;')}" />`;
		}

		function guvenRozeti(skor: number): string {
			if (skor >= 3) return '<span class="guven yuksek" title="Kurum, hisse ve hedef bulundu">✓</span>';
			if (skor >= 1) return '<span class="guven orta" title="Bazı alanlar eksik, kontrol et">?</span>';
			return '<span class="guven dusuk" title="Neredeyse hiçbir alan bulunamadı, elle doldur">!</span>';
		}

		function onizlemeCiz() {
			if (satirlar.length === 0) {
				onizlemeBosEl.style.display = '';
				onizlemeSariciEl.style.display = 'none';
				return;
			}
			onizlemeBosEl.style.display = 'none';
			onizlemeSariciEl.style.display = '';
			onizlemeGovdeEl.innerHTML = satirlar
				.map(
					(s, i) =>
						`<tr>
							<td class="guven-hucre">${guvenRozeti(s.guvenSkoru ?? 3)}</td>
							${ALANLAR.map((a) => `<td>${hucreYaz(s, a, i)}</td>`).join('')}
							<td><button type="button" class="sil" data-kaldir="${i}">Kaldır</button></td>
						</tr>`,
				)
				.join('');
		}

		onizlemeGovdeEl.addEventListener('click', (e) => {
			const hedef = e.target as HTMLElement;
			const index = hedef.dataset.kaldir;
			if (index === undefined) return;
			satirlar.splice(Number(index), 1);
			onizlemeCiz();
		});

		// Hücre düzenleme: input event delegation
		onizlemeGovdeEl.addEventListener('input', (e) => {
			const hedef = e.target as HTMLInputElement;
			if (!hedef.classList.contains('hucre')) return;
			const index = Number(hedef.dataset.index);
			const alan = hedef.dataset.alan as keyof Satir;
			if (!satirlar[index]) return;
			(satirlar[index] as any)[alan] = alan === 'hisse' ? hedef.value.toUpperCase() : hedef.value;
			hedef.classList.toggle('eksik', (alan === 'kurum' || alan === 'hisse' || alan === 'hedef') && !hedef.value);
		});

		// --- 1. Bülten yapıştır + akıllı ayrıştır ---
		function ayristirVeEkle() {
			const yeni = bulteniAyristir(bultenEl.value);
			if (yeni.length === 0) return;
			satirlar.push(...yeni);
			onizlemeCiz();
			bultenEl.value = '';
			durumMesajiEl.textContent = `${yeni.length} satır ayrıştırıldı, aşağıdan kontrol et.`;
			durumMesajiEl.className = 'durum-mesaji basarili';
		}
		ayristirDugmeEl.addEventListener('click', ayristirVeEkle);
		bultenEl.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
				e.preventDefault();
				ayristirVeEkle();
			}
		});

		// --- 2. Tek tek ekleme formu (isteğe bağlı) ---
		function satirEkle() {
			const kurum = fKurum.value.trim();
			const hisse = fHisse.value.trim().toUpperCase();
			const hedef = fHedef.value.trim();
			if (!kurum || !hisse || !hedef) {
				formHataEl.textContent = 'Kurum, hisse kodu ve hedef alanları zorunlu.';
				return;
			}
			formHataEl.textContent = '';
			satirlar.push({
				kurum,
				hisse,
				tur: fTur.value,
				giris: fGiris.value.trim(),
				hedef,
				stop: fStop.value.trim(),
				potansiyel: fPotansiyel.value.trim(),
				guvenSkoru: 3,
			});
			onizlemeCiz();
			fKurum.value = '';
			fHisse.value = '';
			fGiris.value = '';
			fHedef.value = '';
			fStop.value = '';
			fPotansiyel.value = '';
			fKurum.focus();
		}
		ekleDugmeEl.addEventListener('click', satirEkle);
		[fKurum, fHisse, fTur, fGiris, fHedef, fStop, fPotansiyel].forEach((el) => {
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					e.preventDefault();
					satirEkle();
				}
			});
		});

		// --- Kaydetme ---
		kaydetDugmeEl.addEventListener('click', async () => {
			const gecerli = satirlar.filter((s) => s.kurum && s.hisse && s.hedef);
			if (gecerli.length === 0) {
				durumMesajiEl.textContent = 'Önce en az bir geçerli satır oluştur (kurum, hisse ve hedef zorunlu).';
				durumMesajiEl.className = 'durum-mesaji hata';
				return;
			}
			const eksikSayisi = satirlar.length - gecerli.length;
			(kaydetDugmeEl as HTMLButtonElement).disabled = true;
			durumMesajiEl.textContent = 'Kaydediliyor...';
			durumMesajiEl.className = 'durum-mesaji';
			try {
				const yanit = await fetch('/api/oneriler', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ tarih: tarihEl.value, satirlar: gecerli }),
				});
				const veri = await yanit.json();
				if (!yanit.ok) throw new Error(veri.hata || 'Kayıt başarısız.');
				durumMesajiEl.textContent =
					eksikSayisi > 0
						? `${veri.eklenen} öneri kaydedildi. ${eksikSayisi} satır eksik bilgi yüzünden atlandı (listede kaldı, düzeltip tekrar kaydedebilirsin).`
						: `${veri.eklenen} öneri kaydedildi.`;
				durumMesajiEl.className = 'durum-mesaji basarili';
				satirlar = satirlar.filter((s) => !gecerli.includes(s));
				onizlemeCiz();
				kayitliListeYukle();
			} catch (e) {
				durumMesajiEl.textContent = e instanceof Error ? e.message : 'Kayıt başarısız.';
				durumMesajiEl.className = 'durum-mesaji hata';
			} finally {
				(kaydetDugmeEl as HTMLButtonElement).disabled = false;
			}
		});

		temizleDugmeEl.addEventListener('click', () => {
			satirlar = [];
			onizlemeCiz();
			durumMesajiEl.textContent = '';
			durumMesajiEl.className = 'durum-mesaji';
		});

		// --- Bugün kaydedilenler ---
		async function kayitliSil(id: number) {
			await fetch(`/api/oneriler?id=${id}`, { method: 'DELETE' });
			kayitliListeYukle();
		}
		(window as any).kayitliSil = kayitliSil;

		async function kayitliListeYukle() {
			const tarih = tarihEl.value;
			const yanit = await fetch(`/api/oneriler?tarih=${tarih}`);
			const veri = await yanit.json();
			const kayitlar = veri.satirlar || [];
			if (kayitlar.length === 0) {
				kayitliBosEl.textContent = 'Bu tarih için henüz kayıt yok.';
				kayitliBosEl.style.display = '';
				kayitliSariciEl.style.display = 'none';
				return;
			}
			kayitliBosEl.style.display = 'none';
			kayitliSariciEl.style.display = '';
			kayitliGovdeEl.innerHTML = kayitlar
				.map(
					(s: any) =>
						`<tr><td>${s.kurum}</td><td>${s.hisse}</td><td>${s.tur}</td><td>${s.giris ?? '—'}</td><td>${s.hedef}</td><td>${s.stop ?? '—'}</td><td>${s.potansiyel ?? '—'}</td><td><button type="button" class="sil" onclick="kayitliSil(${s.id})">Sil</button></td></tr>`,
				)
				.join('');
		}

		tarihEl.addEventListener('change', kayitliListeYukle);
		yenileDugmeEl.addEventListener('click', kayitliListeYukle);
		kayitliListeYukle();

		// --- 3. Öneri karnesi: sonuç bekleyenleri işaretle ---
		const bekleyenBosEl = document.getElementById('bekleyenBos')!;
		const bekleyenSariciEl = document.getElementById('bekleyenSarici')!;
		const bekleyenGovdeEl = document.getElementById('bekleyenGovde')!;
		const bekleyenYenileDugmeEl = document.getElementById('bekleyenYenileDugme')!;

		let sonucIsleniyor = false; // aynı anda birden fazla PATCH gitmesini engeller

		async function sonucIsaretle(id: number, sonuc: string) {
			if (sonucIsleniyor) return;
			sonucIsleniyor = true;
			try {
				await fetch('/api/oneriler', {
					method: 'PATCH',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ id, sonuc }),
				});
				await bekleyenListeYukle();
				kayitliListeYukle();
			} finally {
				sonucIsleniyor = false;
			}
		}

		// Satır içi onclick yerine tek bir delegasyon dinleyicisi kullanılıyor —
		// bu, yeniden çizim sırasında olası çift bağlanma/çift tetiklenme
		// riskini ortadan kaldırır (önizleme tablosundaki "Kaldır" ile aynı desen).
		bekleyenGovdeEl.addEventListener('click', (e) => {
			const buton = (e.target as HTMLElement).closest('.sonuc-btn') as HTMLButtonElement | null;
			if (!buton) return;
			const id = Number(buton.dataset.id);
			const sonuc = buton.dataset.sonuc!;
			sonucIsaretle(id, sonuc);
		});

		async function bekleyenListeYukle() {
			const yanit = await fetch('/api/oneriler?durum=bekleyen');
			const veri = await yanit.json();
			const satirlar = veri.satirlar || [];
			if (satirlar.length === 0) {
				bekleyenBosEl.textContent = 'Sonuç bekleyen öneri yok.';
				bekleyenBosEl.style.display = '';
				bekleyenSariciEl.style.display = 'none';
				return;
			}
			bekleyenBosEl.style.display = 'none';
			bekleyenSariciEl.style.display = '';
			bekleyenGovdeEl.innerHTML = satirlar
				.map(
					(s: any) => `<tr>
						<td>${s.tarih}</td>
						<td>${s.kurum}</td>
						<td>${s.hisse}</td>
						<td>${s.hedef}</td>
						<td>${s.stop ?? '—'}</td>
						<td class="sag sonuc-dugmeleri">
							<button type="button" class="sonuc-btn hedef" data-id="${s.id}" data-sonuc="hedef">Hedefe ulaştı</button>
							<button type="button" class="sonuc-btn stop" data-id="${s.id}" data-sonuc="stop">Stop oldu</button>
							<button type="button" class="sonuc-btn sure" data-id="${s.id}" data-sonuc="sure_doldu">Süre doldu</button>
						</td>
					</tr>`,
				)
				.join('');
		}
		bekleyenYenileDugmeEl.addEventListener('click', bekleyenListeYukle);
		bekleyenListeYukle();

		// --- 4. Fon hareketi ekle ---
		const fonDonemEl = document.getElementById('fonDonem') as HTMLInputElement;
		const fonAdiEl = document.getElementById('fonAdi') as HTMLInputElement;
		const fonHisseEl = document.getElementById('fonHisse') as HTMLInputElement;
		const fonHareketEl = document.getElementById('fonHareket') as HTMLSelectElement;
		const fonAgirlikEl = document.getElementById('fonAgirlik') as HTMLInputElement;
		const fonHataEl = document.getElementById('fonHata')!;
		const fonEkleDugmeEl = document.getElementById('fonEkleDugme')!;
		const fonListesiEl = document.getElementById('fonListesi')!;

		// Bugünün ayını varsayılan dönem olarak öner (YYYY-MM)
		fonDonemEl.value = new Date().toISOString().slice(0, 7);

		async function fonEkle() {
			const donem = fonDonemEl.value.trim();
			const fonAdi = fonAdiEl.value.trim();
			const hisse = fonHisseEl.value.trim().toUpperCase();
			if (!donem || !fonAdi || !hisse) {
				fonHataEl.textContent = 'Dönem, fon adı ve hisse kodu zorunlu.';
				return;
			}
			fonHataEl.textContent = '';
			(fonEkleDugmeEl as HTMLButtonElement).disabled = true;
			try {
				const yanit = await fetch('/api/fon', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						satirlar: [
							{
								donem,
								fon_adi: fonAdi,
								hisse,
								hareket: fonHareketEl.value,
								agirlik: fonAgirlikEl.value.trim(),
							},
						],
					}),
				});
				if (!yanit.ok) throw new Error((await yanit.json()).hata || 'Kayıt başarısız.');
				fonAdiEl.value = '';
				fonHisseEl.value = '';
				fonAgirlikEl.value = '';
				fonAdiEl.focus();
				fonListesiYukle();
			} catch (e) {
				fonHataEl.textContent = e instanceof Error ? e.message : 'Kayıt başarısız.';
			} finally {
				(fonEkleDugmeEl as HTMLButtonElement).disabled = false;
			}
		}
		fonEkleDugmeEl.addEventListener('click', fonEkle);
		[fonDonemEl, fonAdiEl, fonHisseEl, fonAgirlikEl].forEach((el) => {
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					e.preventDefault();
					fonEkle();
				}
			});
		});

		async function fonSil(id: number) {
			await fetch(`/api/fon?id=${id}`, { method: 'DELETE' });
			fonListesiYukle();
		}

		fonListesiEl.addEventListener('click', (e) => {
			const buton = (e.target as HTMLElement).closest('.sil') as HTMLElement | null;
			if (!buton) return;
			fonSil(Number(buton.dataset.id));
		});

		async function fonListesiYukle() {
			const yanit = await fetch('/api/fon');
			const veri = await yanit.json();
			const satirlar = (veri.satirlar || []).slice(0, 10);
			if (satirlar.length === 0) {
				fonListesiEl.innerHTML = '<p class="bos">Henüz fon hareketi girilmedi.</p>';
				return;
			}
			fonListesiEl.innerHTML = `<p class="ipucu">Son eklenenler:</p>${satirlar
				.map(
					(s: any) =>
						`<div class="fon-satir"><span>${s.donem} · <strong>${s.hisse}</strong> · ${s.fon_adi} · ${s.hareket}</span><button type="button" class="sil" data-id="${s.id}">Sil</button></div>`,
				)
				.join('')}`;
		}
		fonListesiYukle();

		// --- 5. Takvim etkinliği ekle ---
		const takvimTarihEl = document.getElementById('takvimTarih') as HTMLInputElement;
		const takvimTurEl = document.getElementById('takvimTur') as HTMLSelectElement;
		const takvimHisseEl = document.getElementById('takvimHisse') as HTMLInputElement;
		const takvimBaslikEl = document.getElementById('takvimBaslik') as HTMLInputElement;
		const takvimHataEl = document.getElementById('takvimHata')!;
		const takvimEkleDugmeEl = document.getElementById('takvimEkleDugme')!;
		const takvimListesiEl = document.getElementById('takvimListesi')!;

		takvimTarihEl.value = tarihEl.value;

		async function takvimEkle() {
			const tarih = takvimTarihEl.value;
			const baslik = takvimBaslikEl.value.trim();
			if (!tarih || !baslik) {
				takvimHataEl.textContent = 'Tarih ve başlık zorunlu.';
				return;
			}
			takvimHataEl.textContent = '';
			(takvimEkleDugmeEl as HTMLButtonElement).disabled = true;
			try {
				const yanit = await fetch('/api/takvim', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({
						satirlar: [{ tarih, tur: takvimTurEl.value, hisse: takvimHisseEl.value.trim(), baslik }],
					}),
				});
				if (!yanit.ok) throw new Error((await yanit.json()).hata || 'Kayıt başarısız.');
				takvimBaslikEl.value = '';
				takvimHisseEl.value = '';
				takvimBaslikEl.focus();
				takvimListesiYukle();
			} catch (e) {
				takvimHataEl.textContent = e instanceof Error ? e.message : 'Kayıt başarısız.';
			} finally {
				(takvimEkleDugmeEl as HTMLButtonElement).disabled = false;
			}
		}
		takvimEkleDugmeEl.addEventListener('click', takvimEkle);
		[takvimTarihEl, takvimHisseEl, takvimBaslikEl].forEach((el) => {
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					e.preventDefault();
					takvimEkle();
				}
			});
		});

		async function takvimSil(id: number) {
			await fetch(`/api/takvim?id=${id}`, { method: 'DELETE' });
			takvimListesiYukle();
		}
		takvimListesiEl.addEventListener('click', (e) => {
			const buton = (e.target as HTMLElement).closest('.sil') as HTMLElement | null;
			if (!buton) return;
			takvimSil(Number(buton.dataset.id));
		});

		async function takvimListesiYukle() {
			const yanit = await fetch('/api/takvim');
			const veri = await yanit.json();
			const satirlar = (veri.satirlar || []).slice(0, 10);
			if (satirlar.length === 0) {
				takvimListesiEl.innerHTML = '<p class="bos">Henüz etkinlik girilmedi.</p>';
				return;
			}
			takvimListesiEl.innerHTML = `<p class="ipucu">Son eklenenler:</p>${satirlar
				.map(
					(s: any) =>
						`<div class="fon-satir"><span>${s.tarih} · ${s.tur}${s.hisse ? ' · ' + s.hisse : ''} · ${s.baslik}</span><button type="button" class="sil" data-id="${s.id}">Sil</button></div>`,
				)
				.join('')}`;
		}
		takvimListesiYukle();
	</script>

