---
export const prerender = false;

import AnaLayout from '../../layouts/AnaLayout.astro';
import SayfaBasligi from '../../components/SayfaBasligi.astro';
import Kart from '../../components/Kart.astro';
import Rozet from '../../components/Rozet.astro';
import Buton from '../../components/Buton.astro';
import { bugunIstanbul } from '../../lib/tarih';

const bugun = bugunIstanbul();
---

<AnaLayout baslik="Yönetim paneli">
	<SayfaBasligi baslik="Yönetim paneli" ust="PANEL" aciklama="Bülteni yapıştır, sistem alanlara ayırsın, kontrol edip kaydet.">
		<Rozet tur="marka">Sadece Bilal</Rozet>
	</SayfaBasligi>

	<Kart baslik="1. Bülteni yapıştır" altBaslik="Kurumdan gelen metni olduğu gibi yapıştır — sistem alanlara ayırmaya çalışır">
		<div class="tarih-alan">
			<label>
				<span>Öneri tarihi</span>
				<input type="date" id="tarih" value={bugun} />
			</label>
		</div>
		<p class="ipucu">
			Serbest metin de olur ("Garanti BBVA Yatırım: THYAO için 330 TL girişle 365 TL hedef, 310 TL
			stop, günlük işlem"), Excel/Sheets'ten kopyalanmış satırlar da. Birden fazla öneriyi alt alta
			veya boş satırla ayırarak yapıştırabilirsin — her biri ayrı satır olarak ayrıştırılır.
		</p>
		<textarea id="bulten" rows="7" placeholder="Bülteni buraya yapıştır..."></textarea>
		<div class="dugmeler">
			<Buton id="ayristirDugme" type="button">Ayrıştır ve önizle</Buton>
		</div>
	</Kart>

	<details class="toplu">
		<summary>Tek satırı elle, kutu kutu eklemek istersen (isteğe bağlı)</summary>
		<div class="toplu-icerik">
			<div class="form-izgara">
				<label>
					<span>Kurum *</span>
					<input type="text" id="fKurum" placeholder="örn. Garanti BBVA Yatırım" />
				</label>
				<label>
					<span>Hisse kodu *</span>
					<input type="text" id="fHisse" placeholder="örn. THYAO" />
				</label>
				<label>
					<span>Tür</span>
					<select id="fTur">
						<option>Günlük</option>
						<option>Haftalık</option>
						<option>Model portföy</option>
						<option>Takip listesi</option>
					</select>
				</label>
				<label>
					<span>Giriş</span>
					<input type="text" id="fGiris" placeholder="isteğe bağlı" />
				</label>
				<label>
					<span>Hedef *</span>
					<input type="text" id="fHedef" placeholder="örn. 365" />
				</label>
				<label>
					<span>Stop</span>
					<input type="text" id="fStop" placeholder="isteğe bağlı" />
				</label>
				<label>
					<span>Potansiyel</span>
					<input type="text" id="fPotansiyel" placeholder="örn. +%10,6" />
				</label>
			</div>
			<p id="formHata" class="durum-mesaji hata"></p>
			<div class="dugmeler">
				<Buton id="ekleDugme" tur="ikincil" type="button">Satır ekle</Buton>
			</div>
		</div>
	</details>

	<Kart baslik="2. Kontrol et ve onayla" altBaslik="Otomatik ayrıştırılan alanları buradan düzeltebilirsin">
		<div id="onizlemeBos" class="bos">Henüz satır eklemedin.</div>
		<div id="onizlemeSarici" class="tablo-sarici" style="display:none">
			<table>
				<thead>
					<tr>
						<th></th>
						<th>Kurum</th>
						<th>Hisse</th>
						<th>Tür</th>
						<th>Giriş</th>
						<th>Hedef</th>
						<th>Stop</th>
						<th>Potansiyel</th>
						<th></th>
					</tr>
				</thead>
				<tbody id="onizlemeGovde"></tbody>
			</table>
		</div>
		<div class="dugmeler">
			<Buton id="kaydetDugme" type="button">Onayla ve kaydet</Buton>
			<Buton id="temizleDugme" tur="metin" type="button">Listeyi temizle</Buton>
		</div>
		<p id="durumMesaji" class="durum-mesaji"></p>
	</Kart>

	<Kart baslik="Bugün kaydedilenler" altBaslik="Bu tarih için veritabanındaki öneriler">
		<Fragment slot="sag"><button type="button" id="yenileDugme" class="yenile">Yenile</button></Fragment>
		<div id="kayitliBos" class="bos">Yükleniyor...</div>
		<div id="kayitliSarici" class="tablo-sarici" style="display:none">
			<table>
				<thead>
					<tr><th>Kurum</th><th>Hisse</th><th>Tür</th><th>Giriş</th><th>Hedef</th><th>Stop</th><th>Potansiyel</th><th></th></tr>
				</thead>
				<tbody id="kayitliGovde"></tbody>
			</table>
		</div>
	</Kart>

	<script>
		import { bulteniAyristir, type TaslakSatir } from '../../lib/ayristir';

		const tarihEl = document.getElementById('tarih') as HTMLInputElement;

		const bultenEl = document.getElementById('bulten') as HTMLTextAreaElement;
		const ayristirDugmeEl = document.getElementById('ayristirDugme')!;

		const fKurum = document.getElementById('fKurum') as HTMLInputElement;
		const fHisse = document.getElementById('fHisse') as HTMLInputElement;
		const fTur = document.getElementById('fTur') as HTMLSelectElement;
		const fGiris = document.getElementById('fGiris') as HTMLInputElement;
		const fHedef = document.getElementById('fHedef') as HTMLInputElement;
		const fStop = document.getElementById('fStop') as HTMLInputElement;
		const fPotansiyel = document.getElementById('fPotansiyel') as HTMLInputElement;
		const formHataEl = document.getElementById('formHata')!;
		const ekleDugmeEl = document.getElementById('ekleDugme')!;

		const onizlemeBosEl = document.getElementById('onizlemeBos')!;
		const onizlemeSariciEl = document.getElementById('onizlemeSarici')!;
		const onizlemeGovdeEl = document.getElementById('onizlemeGovde')!;
		const kaydetDugmeEl = document.getElementById('kaydetDugme')!;
		const temizleDugmeEl = document.getElementById('temizleDugme')!;
		const durumMesajiEl = document.getElementById('durumMesaji')!;

		const kayitliBosEl = document.getElementById('kayitliBos')!;
		const kayitliSariciEl = document.getElementById('kayitliSarici')!;
		const kayitliGovdeEl = document.getElementById('kayitliGovde')!;
		const yenileDugmeEl = document.getElementById('yenileDugme')!;

		type Satir = TaslakSatir;
		let satirlar: Satir[] = [];

		const ALANLAR: (keyof Satir)[] = ['kurum', 'hisse', 'tur', 'giris', 'hedef', 'stop', 'potansiyel'];

		function hucreYaz(satir: Satir, alan: keyof Satir, index: number): string {
			const deger = String(satir[alan] ?? '');
			const eksikMi = (alan === 'kurum' || alan === 'hisse' || alan === 'hedef') && !deger;
			return `<input type="text" class="hucre ${eksikMi ? 'eksik' : ''}" data-index="${index}" data-alan="${alan}" value="${deger.replace(/"/g, '&quot;')}" />`;
		}

		function guvenRozeti(skor: number): string {
			if (skor >= 3) return '<span class="guven yuksek" title="Kurum, hisse ve hedef bulundu">✓</span>';
			if (skor >= 1) return '<span class="guven orta" title="Bazı alanlar eksik, kontrol et">?</span>';
			return '<span class="guven dusuk" title="Neredeyse hiçbir alan bulunamadı, elle doldur">!</span>';
		}

		function onizlemeCiz() {
			if (satirlar.length === 0) {
				onizlemeBosEl.style.display = '';
				onizlemeSariciEl.style.display = 'none';
				return;
			}
			onizlemeBosEl.style.display = 'none';
			onizlemeSariciEl.style.display = '';
			onizlemeGovdeEl.innerHTML = satirlar
				.map(
					(s, i) =>
						`<tr>
							<td class="guven-hucre">${guvenRozeti(s.guvenSkoru ?? 3)}</td>
							${ALANLAR.map((a) => `<td>${hucreYaz(s, a, i)}</td>`).join('')}
							<td><button type="button" class="sil" data-kaldir="${i}">Kaldır</button></td>
						</tr>`,
				)
				.join('');
		}

		onizlemeGovdeEl.addEventListener('click', (e) => {
			const hedef = e.target as HTMLElement;
			const index = hedef.dataset.kaldir;
			if (index === undefined) return;
			satirlar.splice(Number(index), 1);
			onizlemeCiz();
		});

		// Hücre düzenleme: input event delegation
		onizlemeGovdeEl.addEventListener('input', (e) => {
			const hedef = e.target as HTMLInputElement;
			if (!hedef.classList.contains('hucre')) return;
			const index = Number(hedef.dataset.index);
			const alan = hedef.dataset.alan as keyof Satir;
			if (!satirlar[index]) return;
			(satirlar[index] as any)[alan] = alan === 'hisse' ? hedef.value.toUpperCase() : hedef.value;
			hedef.classList.toggle('eksik', (alan === 'kurum' || alan === 'hisse' || alan === 'hedef') && !hedef.value);
		});

		// --- 1. Bülten yapıştır + akıllı ayrıştır ---
		function ayristirVeEkle() {
			const yeni = bulteniAyristir(bultenEl.value);
			if (yeni.length === 0) return;
			satirlar.push(...yeni);
			onizlemeCiz();
			bultenEl.value = '';
			durumMesajiEl.textContent = `${yeni.length} satır ayrıştırıldı, aşağıdan kontrol et.`;
			durumMesajiEl.className = 'durum-mesaji basarili';
		}
		ayristirDugmeEl.addEventListener('click', ayristirVeEkle);
		bultenEl.addEventListener('keydown', (e) => {
			if (e.key === 'Enter' && (e.ctrlKey || e.metaKey)) {
				e.preventDefault();
				ayristirVeEkle();
			}
		});

		// --- 2. Tek tek ekleme formu (isteğe bağlı) ---
		function satirEkle() {
			const kurum = fKurum.value.trim();
			const hisse = fHisse.value.trim().toUpperCase();
			const hedef = fHedef.value.trim();
			if (!kurum || !hisse || !hedef) {
				formHataEl.textContent = 'Kurum, hisse kodu ve hedef alanları zorunlu.';
				return;
			}
			formHataEl.textContent = '';
			satirlar.push({
				kurum,
				hisse,
				tur: fTur.value,
				giris: fGiris.value.trim(),
				hedef,
				stop: fStop.value.trim(),
				potansiyel: fPotansiyel.value.trim(),
				guvenSkoru: 3,
			});
			onizlemeCiz();
			fKurum.value = '';
			fHisse.value = '';
			fGiris.value = '';
			fHedef.value = '';
			fStop.value = '';
			fPotansiyel.value = '';
			fKurum.focus();
		}
		ekleDugmeEl.addEventListener('click', satirEkle);
		[fKurum, fHisse, fTur, fGiris, fHedef, fStop, fPotansiyel].forEach((el) => {
			el.addEventListener('keydown', (e) => {
				if (e.key === 'Enter') {
					e.preventDefault();
					satirEkle();
				}
			});
		});

		// --- Kaydetme ---
		kaydetDugmeEl.addEventListener('click', async () => {
			const gecerli = satirlar.filter((s) => s.kurum && s.hisse && s.hedef);
			if (gecerli.length === 0) {
				durumMesajiEl.textContent = 'Önce en az bir geçerli satır oluştur (kurum, hisse ve hedef zorunlu).';
				durumMesajiEl.className = 'durum-mesaji hata';
				return;
			}
			const eksikSayisi = satirlar.length - gecerli.length;
			(kaydetDugmeEl as HTMLButtonElement).disabled = true;
			durumMesajiEl.textContent = 'Kaydediliyor...';
			durumMesajiEl.className = 'durum-mesaji';
			try {
				const yanit = await fetch('/api/oneriler', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify({ tarih: tarihEl.value, satirlar: gecerli }),
				});
				const veri = await yanit.json();
				if (!yanit.ok) throw new Error(veri.hata || 'Kayıt başarısız.');
				durumMesajiEl.textContent =
					eksikSayisi > 0
						? `${veri.eklenen} öneri kaydedildi. ${eksikSayisi} satır eksik bilgi yüzünden atlandı (listede kaldı, düzeltip tekrar kaydedebilirsin).`
						: `${veri.eklenen} öneri kaydedildi.`;
				durumMesajiEl.className = 'durum-mesaji basarili';
				satirlar = satirlar.filter((s) => !gecerli.includes(s));
				onizlemeCiz();
				kayitliListeYukle();
			} catch (e) {
				durumMesajiEl.textContent = e instanceof Error ? e.message : 'Kayıt başarısız.';
				durumMesajiEl.className = 'durum-mesaji hata';
			} finally {
				(kaydetDugmeEl as HTMLButtonElement).disabled = false;
			}
		});

		temizleDugmeEl.addEventListener('click', () => {
			satirlar = [];
			onizlemeCiz();
			durumMesajiEl.textContent = '';
			durumMesajiEl.className = 'durum-mesaji';
		});

		// --- Bugün kaydedilenler ---
		async function kayitliSil(id: number) {
			await fetch(`/api/oneriler?id=${id}`, { method: 'DELETE' });
			kayitliListeYukle();
		}
		(window as any).kayitliSil = kayitliSil;

		async function kayitliListeYukle() {
			const tarih = tarihEl.value;
			const yanit = await fetch(`/api/oneriler?tarih=${tarih}`);
			const veri = await yanit.json();
			const kayitlar = veri.satirlar || [];
			if (kayitlar.length === 0) {
				kayitliBosEl.textContent = 'Bu tarih için henüz kayıt yok.';
				kayitliBosEl.style.display = '';
				kayitliSariciEl.style.display = 'none';
				return;
			}
			kayitliBosEl.style.display = 'none';
			kayitliSariciEl.style.display = '';
			kayitliGovdeEl.innerHTML = kayitlar
				.map(
					(s: any) =>
						`<tr><td>${s.kurum}</td><td>${s.hisse}</td><td>${s.tur}</td><td>${s.giris ?? '—'}</td><td>${s.hedef}</td><td>${s.stop ?? '—'}</td><td>${s.potansiyel ?? '—'}</td><td><button type="button" class="sil" onclick="kayitliSil(${s.id})">Sil</button></td></tr>`,
				)
				.join('');
		}

		tarihEl.addEventListener('change', kayitliListeYukle);
		yenileDugmeEl.addEventListener('click', kayitliListeYukle);
		kayitliListeYukle();
	</script>

	<style>
		.tarih-alan {
			display: flex;
			flex-direction: column;
			gap: 6px;
			font-size: 13px;
			font-weight: 500;
			color: var(--metin-ikincil);
			max-width: 220px;
		}
		.form-izgara {
			display: grid;
			grid-template-columns: repeat(4, minmax(0, 1fr));
			gap: 14px;
			margin-top: 12px;
		}
		label {
			display: flex;
			flex-direction: column;
			gap: 6px;
			font-size: 13px;
			font-weight: 500;
			color: var(--metin-ikincil);
		}
		input[type='date'],
		input[type='text'],
		select {
			height: 44px;
			border: 1px solid var(--kenarlik);
			border-radius: 10px;
			padding: 0 14px;
			font: inherit;
			font-size: 14px;
			font-weight: 600;
			color: var(--metin);
			background: #faf9f5;
		}
		input:focus,
		select:focus,
		textarea:focus {
			outline: 2px solid var(--marka);
			outline-offset: 1px;
		}
		.toplu {
			background: var(--kart);
			border: 1px solid var(--kenarlik);
			border-radius: 16px;
			padding: 4px 24px;
		}
		.toplu summary {
			padding: 16px 0;
			font-size: 14px;
			font-weight: 600;
			cursor: pointer;
			color: var(--marka);
		}
		.toplu-icerik {
			padding-bottom: 20px;
		}
		.ipucu {
			margin: 0;
			font-size: 13px;
			color: var(--metin-ikincil);
		}
		textarea {
			width: 100%;
			border: 1px solid var(--kenarlik);
			border-radius: 10px;
			padding: 12px 14px;
			font-family: var(--font-mono);
			font-size: 13px;
			background: #faf9f5;
			resize: vertical;
		}
		.dugmeler {
			display: flex;
			gap: 10px;
		}
		.bos {
			font-size: 14px;
			color: var(--metin-ikincil);
			padding: 24px;
			text-align: center;
			background: #faf9f5;
			border-radius: 10px;
		}
		.tablo-sarici {
			overflow-x: auto;
		}
		table {
			width: 100%;
			border-collapse: collapse;
			font-size: 13px;
		}
		th {
			text-align: left;
			font-size: 11px;
			font-weight: 600;
			letter-spacing: 0.5px;
			color: var(--metin-ikincil);
			padding: 0 8px 8px;
			border-bottom: 1px solid var(--cizgi);
			text-transform: uppercase;
			white-space: nowrap;
		}
		td {
			padding: 6px;
			border-bottom: 1px solid var(--cizgi);
			white-space: nowrap;
		}
		.hucre {
			height: 36px;
			min-width: 90px;
			border: 1px solid transparent;
			border-radius: 6px;
			padding: 0 8px;
			font: inherit;
			font-size: 13px;
			font-weight: 500;
			background: transparent;
			color: var(--metin);
			width: 100%;
			box-sizing: border-box;
		}
		.hucre:hover {
			border-color: var(--kenarlik);
			background: #faf9f5;
		}
		.hucre:focus {
			border-color: var(--marka);
			background: #fff;
			outline: none;
		}
		.hucre.eksik {
			background: #f8e4e2;
			border-color: #edc7c2;
		}
		.guven-hucre {
			text-align: center;
			width: 28px;
		}
		.guven {
			display: inline-flex;
			align-items: center;
			justify-content: center;
			width: 20px;
			height: 20px;
			border-radius: 50%;
			font-size: 11px;
			font-weight: 700;
			cursor: help;
		}
		.guven.yuksek {
			background: #e3f2ea;
			color: var(--yukselis);
		}
		.guven.orta {
			background: #fbf0dd;
			color: var(--etiket-metin);
		}
		.guven.dusuk {
			background: #f8e4e2;
			color: var(--dusus);
		}
		.sil {
			border: 0;
			background: transparent;
			color: var(--dusus);
			font-weight: 600;
			font-size: 12px;
			cursor: pointer;
			padding: 4px 8px;
		}
		.yenile {
			border: 0;
			background: transparent;
			color: var(--marka);
			font-weight: 600;
			font-size: 13px;
			cursor: pointer;
		}
		.durum-mesaji {
			margin: 0;
			font-size: 13px;
			font-weight: 600;
			min-height: 18px;
		}
		.durum-mesaji.basarili {
			color: var(--yukselis);
		}
		.durum-mesaji.hata {
			color: var(--dusus);
		}

		@media (max-width: 899px) {
			.form-izgara {
				grid-template-columns: repeat(2, minmax(0, 1fr));
			}
		}
	</style>
</AnaLayout>
